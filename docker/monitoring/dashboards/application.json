{
  "uid": "rusys-application",
  "title": "Application",
  "id": null,
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": ["rusys", "production", "monitoring"],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Rusys Overview",
      "type": "link",
      "url": "/d/rusys-overview",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Infrastructure",
      "type": "link",
      "url": "/d/rusys-infrastructure",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Application",
      "type": "link",
      "url": "/d/rusys-application",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Frontend & Usage",
      "type": "link",
      "url": "/d/rusys-frontend-usage",
      "keepTime": true,
      "includeVars": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "label": "prometheus data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "refresh": 1
      },
      {
        "name": "loki",
        "label": "loki data source",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "refresh": 1
      },
      {
        "name": "tempo",
        "label": "tempo data source",
        "type": "datasource",
        "query": "tempo",
        "current": {},
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Coverage and interpretation",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Gateway latency uses numeric request_time, including upstream and proxy time. API excludes /api/health so external probes cannot mask errors or satisfy the traffic guard. Trace data is sampled; use gateway logs for request volume. Parsed request fields are aggregated away from numeric series."
      }
    },
    {
      "id": 2,
      "title": "NGINX requests per second",
      "type": "timeseries",
      "description": "Production Rusys telemetry. No data means missing telemetry or no eligible activity; verify collection before interpreting it as healthy.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data — check collection"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(rate({project=\"rusys\",environment=\"production\",container=\"rusys-gateway\"} | json | uri != \"\" | __error__=\"\" [5m]))",
          "queryType": "range",
          "editorMode": "code",
          "legendFormat": "NGINX requests per second"
        }
      ]
    },
    {
      "id": 3,
      "title": "NGINX requests by status",
      "type": "timeseries",
      "description": "Production Rusys telemetry. No data means missing telemetry or no eligible activity; verify collection before interpreting it as healthy.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data — check collection"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (status) (count_over_time({project=\"rusys\",environment=\"production\",container=\"rusys-gateway\"} | json | uri != \"\" | __error__=\"\" [5m]))",
          "queryType": "range",
          "editorMode": "code",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "NGINX p95 duration",
      "type": "timeseries",
      "description": "Production Rusys telemetry. No data means missing telemetry or no eligible activity; verify collection before interpreting it as healthy.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data — check collection"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "quantile_over_time(0.95, {project=\"rusys\",environment=\"production\",container=\"rusys-gateway\"} | json | uri != \"\" | __error__=\"\" | unwrap request_time | __error__=\"\" [5m]) by (container)",
          "queryType": "range",
          "editorMode": "code",
          "legendFormat": "NGINX p95 duration"
        }
      ]
    },
    {
      "id": 5,
      "title": "API requests per 5 minutes (alert requires at least 20)",
      "type": "timeseries",
      "description": "Production Rusys telemetry. No data means missing telemetry or no eligible activity; verify collection before interpreting it as healthy.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data — check collection"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({project=\"rusys\",environment=\"production\",container=\"rusys-gateway\"} | json | uri != \"\" | __error__=\"\" | uri =~ \"^/api/.*\" | uri != \"/api/health\" [5m]))",
          "queryType": "range",
          "editorMode": "code",
          "legendFormat": "API requests per 5 minutes (alert requires at least 20)"
        }
      ]
    },
    {
      "id": 6,
      "title": "API 5xx fraction",
      "type": "timeseries",
      "description": "Production Rusys telemetry. No data means missing telemetry or no eligible activity; verify collection before interpreting it as healthy.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data — check collection"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "(sum(count_over_time({project=\"rusys\",environment=\"production\",container=\"rusys-gateway\"} | json | uri != \"\" | __error__=\"\" | uri =~ \"^/api/.*\" | uri != \"/api/health\" | status >= 500 [5m])) or (sum(count_over_time({project=\"rusys\",environment=\"production\",container=\"rusys-gateway\"} | json | uri != \"\" | __error__=\"\" | uri =~ \"^/api/.*\" | uri != \"/api/health\" [5m])) * 0)) / sum(count_over_time({project=\"rusys\",environment=\"production\",container=\"rusys-gateway\"} | json | uri != \"\" | __error__=\"\" | uri =~ \"^/api/.*\" | uri != \"/api/health\" [5m]))",
          "queryType": "range",
          "editorMode": "code",
          "legendFormat": "API 5xx fraction"
        }
      ]
    },
    {
      "id": 7,
      "title": "API p95 duration",
      "type": "timeseries",
      "description": "Production Rusys telemetry. No data means missing telemetry or no eligible activity; verify collection before interpreting it as healthy.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data — check collection"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "quantile_over_time(0.95, {project=\"rusys\",environment=\"production\",container=\"rusys-gateway\"} | json | uri != \"\" | __error__=\"\" | uri =~ \"^/api/.*\" | uri != \"/api/health\" | unwrap request_time | __error__=\"\" [5m]) by (container)",
          "queryType": "range",
          "editorMode": "code",
          "legendFormat": "API p95 duration"
        }
      ]
    },
    {
      "id": 8,
      "title": "Application failure events",
      "type": "timeseries",
      "description": "Production Rusys telemetry. No data means missing telemetry or no eligible activity; verify collection before interpreting it as healthy.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data — check collection"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (slot, event) (count_over_time({project=\"rusys\",environment=\"production\",service_name=\"rusys-web\"} | json | event =~ \"api_handler_failed|request_failed\" | __error__=\"\" [5m]))",
          "queryType": "range",
          "editorMode": "code",
          "legendFormat": "{{slot}} · {{event}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "MongoDB connections",
      "type": "timeseries",
      "description": "Production Rusys telemetry. No data means missing telemetry or no eligible activity; verify collection before interpreting it as healthy.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data — check collection"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "mongodb_ss_connections{project=\"rusys\",environment=\"production\",job=\"integrations/mongodb\",instance=\"rusys-db\",conn_type=~\"current|available|active\"}",
          "queryType": "range",
          "instant": false,
          "range": true,
          "editorMode": "code",
          "legendFormat": "{{conn_type}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "MongoDB operations per second",
      "type": "timeseries",
      "description": "Production Rusys telemetry. No data means missing telemetry or no eligible activity; verify collection before interpreting it as healthy.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No data — check collection"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
