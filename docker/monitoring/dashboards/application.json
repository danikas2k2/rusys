          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${tempo}"
          },
          "expr": "{ resource.service.name = \"rusys-web\" }",
          "query": "{ resource.service.name = \"rusys-web\" }",
          "tableType": "traces",
          "filters": [],
          "queryType": "traceql",
          "editorMode": "code",
          "legendFormat": "Recent backend traces (open a trace for nested operations)"
