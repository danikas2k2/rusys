            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (legacy_op_type) (rate(mongodb_ss_opcounters{project=\"rusys\",environment=\"production\",job=\"integrations/mongodb\",instance=\"rusys-db\"}[5m]))",
          "queryType": "range",
          "instant": false,
          "range": true,
          "editorMode": "code",
          "legendFormat": "{{legacy_op_type}}"
        }
      ]
    },
    {
      "id": 11,
      "title": "MongoDB database connection health",
      "type": "timeseries",
      "description": "Production Rusys telemetry. No data means missing telemetry or no eligible activity; verify collection before interpreting it as healthy.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "noValue": "No data — check collection"
        },
        "overrides": []
