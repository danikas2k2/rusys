  "panels": [
    {
      "id": 1,
      "title": "Collection coverage",
      "type": "text",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Tracking starts by default on configured production origins. Browser Do Not Track and Global Privacy Control do not disable collection. These are **event counts**, not all visitors or unique users. Forms record completed field edits and validation categories, never their contents. One action can emit started and success/error events; use **Confirmed data operations** for successful mutations. Legacy create/upload/export events are excluded from the usage totals. Empty panels can mean no eligible activity or that the instrumented release has not been deployed."
      }
    },
    {
      "id": 2,
      "title": "Recorded usage events",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "noValue": "No recorded events"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "expr": "sum (count_over_time({app_id=\"$app_id\",kind=\"event\"} | logfmt | event_name=~\"dialog_opened|dialog_closed|form_field_changed|form_submitted|form_validation_failed|form_result|checkbox_changed|list_reordered|refresh|auth|navigation|tab_changed|view_changed|data_action|search_performed|filter_applied\" | __error__=\"\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant",
          "refId": "A"
        }
      ]
    },
