        }
      },
      {
        "refId": "B",
        "datasourceUid": "__expr__",
        "relativeTimeRange": {
          "from": 0,
          "to": 0
        },
        "model": {
          "refId": "B",
          "type": "threshold",
          "expression": "A",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [0.5]
              },
              "operator": {
                "type": "and"
              },
              "reducer": {
                "type": "last",
                "params": []
              },
              "type": "query",
