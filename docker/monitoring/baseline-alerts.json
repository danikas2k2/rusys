  {
    "uid": "rusys-api-errors",
    "title": "Rusys API 5xx errors",
    "ruleGroup": "rusys-baseline",
    "folderUID": "rusys-monitoring",
    "condition": "B",
    "for": "5m",
    "noDataState": "OK",
    "execErrState": "Error",
    "labels": {
      "project": "rusys",
      "environment": "production",
      "severity": "warning"
    },
    "annotations": {
      "summary": "API 5xx ratio exceeds 2% with at least 20 non-health API requests per 5-minute window, sustained for 5 minutes.",
      "description": "Inspect gateway status, application failures and traces; correlate with release/slot. Low traffic does not trigger this rate alert.",
      "runbook_url": "https://github.com/danikas2k2/rusys/blob/main/docs/monitoring/DASHBOARDS-AND-ALERTS.md",
      "__dashboardUid__": "rusys-application",
      "__panelId__": "6"
    },
    "notification_settings": {
      "receiver": "Rusys uptime email",
      "group_by": ["grafana_folder", "alertname"],
      "group_wait": "30s",
      "group_interval": "5m",
      "repeat_interval": "4h"
    },
    "data": [
      {
        "refId": "A",
        "datasourceUid": "${loki}",
        "relativeTimeRange": {
          "from": 900,
          "to": 0
        },
        "queryType": "instant",
        "model": {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "(((sum(count_over_time({project=\"rusys\",environment=\"production\",container=\"rusys-gateway\"} | json | uri != \"\" | __error__=\"\" | uri =~ \"^/api/.*\" | uri != \"/api/health\" | status >= 500 [5m])) or (sum(count_over_time({project=\"rusys\",environment=\"production\",container=\"rusys-gateway\"} | json | uri != \"\" | __error__=\"\" | uri =~ \"^/api/.*\" | uri != \"/api/health\" [5m])) * 0)) / sum(count_over_time({project=\"rusys\",environment=\"production\",container=\"rusys-gateway\"} | json | uri != \"\" | __error__=\"\" | uri =~ \"^/api/.*\" | uri != \"/api/health\" [5m]))) > bool 0.02) and (sum(count_over_time({project=\"rusys\",environment=\"production\",container=\"rusys-gateway\"} | json | uri != \"\" | __error__=\"\" | uri =~ \"^/api/.*\" | uri != \"/api/health\" [5m])) >= 20)",
          "instant": true,
          "range": false,
          "queryType": "instant",
          "intervalMs": 1000,
          "maxDataPoints": 43200
        }
      },
      {
        "refId": "B",
        "datasourceUid": "__expr__",
        "relativeTimeRange": {
          "from": 0,
          "to": 0
        },
        "model": {
          "refId": "B",
          "type": "threshold",
          "expression": "A",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [0.5]
              },
              "operator": {
                "type": "and"
              },
              "reducer": {
                "type": "last",
                "params": []
              },
              "type": "query",
              "query": {
                "params": ["B"]
              }
            }
          ]
        }
      }
    ]
  },
  {
    "uid": "rusys-api-latency",
    "title": "Rusys API p95 latency",
    "ruleGroup": "rusys-baseline",
    "folderUID": "rusys-monitoring",
    "condition": "B",
    "for": "10m",
    "noDataState": "OK",
    "execErrState": "Error",
    "labels": {
      "project": "rusys",
      "environment": "production",
      "severity": "warning"
    },
    "annotations": {
      "summary": "API p95 exceeds 1 second with at least 20 non-health API requests per 5-minute window for 10 minutes.",
      "description": "Open slow backend traces; inspect MongoDB, image work, CPU and memory before adjusting the threshold.",
      "runbook_url": "https://github.com/danikas2k2/rusys/blob/main/docs/monitoring/DASHBOARDS-AND-ALERTS.md",
      "__dashboardUid__": "rusys-application",
      "__panelId__": "7"
    },
    "notification_settings": {
      "receiver": "Rusys uptime email",
      "group_by": ["grafana_folder", "alertname"],
      "group_wait": "30s",
      "group_interval": "5m",
      "repeat_interval": "4h"
    },
    "data": [
      {
        "refId": "A",
        "datasourceUid": "${loki}",
        "relativeTimeRange": {
          "from": 900,
          "to": 0
        },
        "queryType": "instant",
        "model": {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "(quantile_over_time(0.95, {project=\"rusys\",environment=\"production\",container=\"rusys-gateway\"} | json | uri != \"\" | __error__=\"\" | uri =~ \"^/api/.*\" | uri != \"/api/health\" | unwrap request_time | __error__=\"\" [5m]) by (container) > bool 1) and on() (sum(count_over_time({project=\"rusys\",environment=\"production\",container=\"rusys-gateway\"} | json | uri != \"\" | __error__=\"\" | uri =~ \"^/api/.*\" | uri != \"/api/health\" [5m])) >= 20)",
          "instant": true,
          "range": false,
          "queryType": "instant",
          "intervalMs": 1000,
          "maxDataPoints": 43200
        }
      },
      {
        "refId": "B",
        "datasourceUid": "__expr__",
        "relativeTimeRange": {
          "from": 0,
          "to": 0
        },
        "model": {
          "refId": "B",
          "type": "threshold",
          "expression": "A",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [0.5]
              },
              "operator": {
                "type": "and"
              },
              "reducer": {
                "type": "last",
                "params": []
              },
              "type": "query",
              "query": {
                "params": ["B"]
              }
            }
          ]
        }
      }
    ]
  },
  {
    "uid": "rusys-mongodb-down",
    "title": "Rusys MongoDB monitoring unavailable",
    "ruleGroup": "rusys-baseline",
    "folderUID": "rusys-monitoring",
    "condition": "B",
    "for": "5m",
    "noDataState": "OK",
    "execErrState": "Error",
    "labels": {
      "project": "rusys",
      "environment": "production",
      "severity": "warning"
    },
    "annotations": {
      "summary": "MongoDB exporter scrape or database connection unavailable/missing for 5 minutes.",
      "description": "Check Alloy discovery, exporter credentials/clusterMonitor role and private MongoDB connectivity. Do not expose database ports.",
      "runbook_url": "https://github.com/danikas2k2/rusys/blob/main/docs/monitoring/DASHBOARDS-AND-ALERTS.md",
      "__dashboardUid__": "rusys-application",
      "__panelId__": "11"
    },
    "notification_settings": {
      "receiver": "Rusys uptime email",
      "group_by": ["grafana_folder", "alertname"],
      "group_wait": "30s",
      "group_interval": "5m",
      "repeat_interval": "4h"
    },
    "data": [
      {
        "refId": "A",
        "datasourceUid": "${prometheus}",
        "relativeTimeRange": {
          "from": 900,
          "to": 0
        },
        "queryType": "instant",
        "model": {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "((up{project=\"rusys\",environment=\"production\",job=\"integrations/mongodb\",instance=\"rusys-db\"} == 0) + 1) or ((mongodb_up{project=\"rusys\",environment=\"production\",job=\"integrations/mongodb\",instance=\"rusys-db\"} == 0) + 1) or absent(up{project=\"rusys\",environment=\"production\",job=\"integrations/mongodb\",instance=\"rusys-db\"}) or absent(mongodb_up{project=\"rusys\",environment=\"production\",job=\"integrations/mongodb\",instance=\"rusys-db\"})",
