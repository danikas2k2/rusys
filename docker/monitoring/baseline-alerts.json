      "environment": "production",
      "severity": "warning"
    },
    "annotations": {
      "summary": "Persistent filesystem usage above 80% for 15 minutes.",
      "description": "Confirm the affected device/mount; inspect Docker storage, logs and backups. Do not delete database files.",
      "runbook_url": "https://github.com/danikas2k2/rusys/blob/main/docs/monitoring/DASHBOARDS-AND-ALERTS.md",
      "__dashboardUid__": "rusys-infrastructure",
