      "project": "rusys",
      "environment": "production",
      "severity": "warning"
    },
    "annotations": {
      "summary": "Container working set exceeds 85% of a finite configured memory limit for 5 minutes.",
      "description": "Inspect the named container, its configured limit, release and workload. Unlimited containers are excluded.",
      "runbook_url": "https://github.com/danikas2k2/rusys/blob/main/docs/monitoring/DASHBOARDS-AND-ALERTS.md",
      "__dashboardUid__": "rusys-infrastructure",
      "__panelId__": "6"
