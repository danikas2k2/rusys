      {
        "refId": "A",
        "datasourceUid": "${prometheus}",
        "relativeTimeRange": {
          "from": 900,
          "to": 0
        },
        "queryType": "instant",
        "model": {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "((container_memory_working_set_bytes{project=\"rusys\",environment=\"production\",host=\"synology-ds923\",name=~\"rusys-.*\"} / container_spec_memory_limit_bytes{project=\"rusys\",environment=\"production\",host=\"synology-ds923\",name=~\"rusys-.*\"}) > bool 0.85) and (container_spec_memory_limit_bytes{project=\"rusys\",environment=\"production\",host=\"synology-ds923\",name=~\"rusys-.*\"} > 0 and container_spec_memory_limit_bytes{project=\"rusys\",environment=\"production\",host=\"synology-ds923\",name=~\"rusys-.*\"} < 1e15)",
