[
  {
    "uid": "rusys-public-down",
    "title": "Rusys public endpoint unavailable",
    "ruleGroup": "rusys-baseline",
    "folderUID": "rusys-monitoring",
    "condition": "B",
    "for": "0s",
    "noDataState": "OK",
    "execErrState": "Error",
    "labels": {
      "project": "rusys",
      "environment": "production",
      "severity": "critical"
    },
    "annotations": {
      "summary": "All probes failed throughout the last 15 minutes with at least three executions per probe.",
      "description": "Check public DNS/TLS, NAS connectivity, gateway, and active slot. Check both homepage and health checks in Synthetic Monitoring.",
      "runbook_url": "https://github.com/danikas2k2/rusys/blob/main/docs/monitoring/DASHBOARDS-AND-ALERTS.md",
      "__dashboardUid__": "rusys-overview",
      "__panelId__": "2"
    },
    "notification_settings": {
      "receiver": "Rusys uptime email",
      "group_by": ["grafana_folder", "alertname"],
      "group_wait": "30s",
      "group_interval": "5m",
      "repeat_interval": "4h"
    },
    "data": [
      {
        "refId": "A",
        "datasourceUid": "${prometheus}",
        "relativeTimeRange": {
          "from": 900,
          "to": 0
        },
        "queryType": "instant",
        "model": {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "(max by (job) (max_over_time(probe_success{project=\"rusys\",environment=\"production\",job=~\"rusys-homepage|rusys-health\"}[15m])) == bool 0) and (min by (job) (count_over_time(probe_success{project=\"rusys\",environment=\"production\",job=~\"rusys-homepage|rusys-health\"}[15m])) >= 3)",
          "instant": true,
          "range": false,
          "queryType": "instant",
          "intervalMs": 1000,
          "maxDataPoints": 43200
        }
      },
      {
        "refId": "B",
        "datasourceUid": "__expr__",
        "relativeTimeRange": {
          "from": 0,
          "to": 0
        },
        "model": {
          "refId": "B",
          "type": "threshold",
          "expression": "A",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [0.5]
              },
              "operator": {
                "type": "and"
              },
              "reducer": {
                "type": "last",
                "params": []
              },
              "type": "query",
              "query": {
                "params": ["B"]
              }
            }
          ]
        }
      }
    ]
  },
