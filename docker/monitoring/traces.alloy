// Design: only blue/green applications share traces-private (an internal bridge).
// Bind only its fixed private interface, never the egress interface or host ports.
otelcol.receiver.otlp "applications" {
  http {
    endpoint = sys.env("OTLP_LISTEN_ADDRESS")
    max_request_body_size = "2MiB"
  }
  output {
    traces = [otelcol.processor.memory_limiter.traces.input]
  }
}

otelcol.processor.memory_limiter "traces" {
  check_interval = "1s"
  limit = "128MiB"
  spike_limit = "32MiB"
  output {
    traces = [otelcol.processor.batch.traces.input]
  }
}

otelcol.processor.batch "traces" {
  timeout = "5s"
  send_batch_size = 64
  send_batch_max_size = 128
  output {
    traces = [otelcol.exporter.otlphttp.grafana_cloud.input]
  }
}

otelcol.auth.basic "grafana_cloud" {
  username = sys.env("GC_OTLP_USER")
  password = sys.env("GC_OTLP_TOKEN")
}

otelcol.exporter.otlphttp "grafana_cloud" {
  client {
    endpoint = sys.env("GC_OTLP_ENDPOINT")
    auth = otelcol.auth.basic.grafana_cloud.handler
    timeout = "10s"
  }
  sending_queue {
    queue_size = 128
    num_consumers = 1
  }
  retry_on_failure {
    max_elapsed_time = "30s"
  }
}
