prometheus.exporter.cadvisor "docker" {
  docker_only            = true
  store_container_labels = false
}

prometheus.exporter.unix "nas" {
  rootfs_path = "/rootfs"
  procfs_path = "/host/proc"
  sysfs_path  = "/sys"
}

prometheus.scrape "docker" {
  targets         = prometheus.exporter.cadvisor.docker.targets
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.scrape "nas" {
  targets         = prometheus.exporter.unix.nas.targets
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

// Host networking has no Compose DNS. Discover the private bridge address instead;
// never publish MongoDB or a separate HTTP exporter port on the NAS.
discovery.docker "mongodb" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "15s"

  filter {
    name   = "label"
    values = ["com.docker.compose.project=rusys-app"]
  }
  filter {
    name   = "label"
    values = ["com.docker.compose.service=rusys-db"]
  }
}

discovery.relabel "mongodb" {
  targets = discovery.docker.mongodb.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/rusys-db"
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_docker_network_name", "__meta_docker_port_private"]
    regex         = "rusys-app_rusys-net;27017"
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_docker_network_ip"]
    target_label  = "__address__"
    replacement   = "$1:27017"
  }
}

prometheus.exporter.mongodb "rusys" {
  // The fixed container name/network/port identifies one target. If it is absent,
  // append a closed loopback port as the fallback for startup and recreation.
  // Extract only percent-encoded credentials from the NAS URI. Re-encode both
  // fields and reconstruct the address/options so URI content cannot redirect
  // credentials outside the discovered private database, even via extra @ or /.
  mongodb_uri = "mongodb://" +
    string.replace(encoding.url_encode(encoding.url_decode(string.split(string.split(sys.env("MONGODB_MONITORING_URI"), "mongodb://")[1], ":")[0])), "+", "%20") + ":" +
    string.replace(encoding.url_encode(encoding.url_decode(string.split(string.split(string.split(sys.env("MONGODB_MONITORING_URI"), "mongodb://")[1], ":")[1], "@")[0])), "+", "%20") + "@" +
    array.concat(discovery.relabel.mongodb.output, [{__address__ = "127.0.0.1:1"}])[0]["__address__"] +
    "/admin?authSource=admin&serverSelectionTimeoutMS=3000&connectTimeoutMS=3000"

  direct_connect         = true
  collect_all            = false
  compatible_mode        = false
  enable_diagnostic_data = true
}

discovery.relabel "mongodb_metrics" {
  targets = prometheus.exporter.mongodb.rusys.targets

  // Keep a stable series identity when Docker assigns a new bridge IP.
  rule {
    target_label = "instance"
    replacement  = "rusys-db"
  }
  rule {
    target_label = "job"
    replacement  = "integrations/mongodb"
  }
}

prometheus.scrape "mongodb" {
  targets         = discovery.relabel.mongodb_metrics.output
  scrape_interval = "15s"
  scrape_timeout  = "10s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
  external_labels = {
    project     = "rusys",
    environment = "production",
    host        = "synology-ds923",
  }

  endpoint {
    url = sys.env("GC_METRICS_URL")

    basic_auth {
      username = sys.env("GC_METRICS_USER")
      password = sys.env("GC_METRICS_TOKEN")
    }
  }
}

// Only this Compose project and its fixed service set may produce Loki streams.
discovery.docker "rusys_logs" {
  host = "unix:///var/run/docker.sock"

  filter {
    name   = "label"
    values = ["com.docker.compose.project=rusys-app"]
  }
}

discovery.relabel "rusys_logs" {
  targets = discovery.docker.rusys_logs.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "rusys-app-(blue|green)|rusys-db|rusys-gateway|monitoring"
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "container"
  }
  rule {
    source_labels = ["container"]
    regex         = "monitoring"
    target_label  = "container"
    replacement   = "rusys-monitoring"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service_name"
  }
  rule {
    source_labels = ["service_name"]
    regex         = "rusys-app-(blue|green)"
    target_label  = "service_name"
    replacement   = "rusys-web"
  }
  rule {
    source_labels = ["container"]
    regex         = "rusys-app-(blue|green)"
    target_label  = "slot"
    replacement   = "$1"
  }
}

loki.source.docker "rusys" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.rusys_logs.output
  relabel_rules = discovery.relabel.rusys_logs.rules
  labels        = { project = "rusys", environment = "production", host = "synology-ds923" }
  forward_to    = [loki.process.rusys_privacy.receiver]
}

loki.process "rusys_privacy" {
  forward_to = [loki.write.grafana_cloud.receiver]

  stage.match {
    selector = `{service_name="rusys-web"}`

    // Exact logger schema, including field order: unknown/raw framework output fails closed.
    stage.regex {
      expression = `^(?P<safe_app>\{"timestamp":"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{3}Z","level":"(debug|info|warn|error)","service":"rusys-web","slot":"(blue|green|unknown)","version":"([0-9]{1,6}\.[0-9]{1,6}\.[0-9]{1,6}|unknown)","event":"(server_started|api_handler_failed|request_failed|runtime_output_redacted)"(,"method":"(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS)")?(,"routeType":"(render|route|action|proxy)")?(,"status":[1-5][0-9]{2})?\})$`
    }
    stage.template {
      source   = "safe_app"
      template = `{{ if .Value }}{{ .Value }}{{ else }}{"service":"rusys-web","event":"runtime_output_redacted"}{{ end }}`
    }
    stage.output {
      source = "safe_app"
    }
  }

  // Infrastructure logs can contain addresses, URIs, queries, credentials and personal data.
  // Rebuild entries from bounded diagnostic fields; never forward the original line.
  stage.match {
    selector = `{service_name="rusys-db"}`
    stage.regex {
      expression = `"s"\s*:\s*"(?P<severity>I|W|E|F|D[1-5])"`
    }
    stage.regex {
      expression = `"id"\s*:\s*(?P<message_id>[0-9]{1,8})[,}]`
    }
    stage.template {
      source   = "safe_infra"
      template = `{"service":"rusys-db","event":"database_output_redacted","severity":"{{ if .severity }}{{ .severity }}{{ else }}unknown{{ end }}","message_id":"{{ if .message_id }}{{ .message_id }}{{ else }}unknown{{ end }}"}`
    }
    stage.output {
      source = "safe_infra"
    }
  }
  stage.match {
    selector = `{service_name="rusys-gateway"}`
    // Accept only the exact bounded JSON access schema. Error/legacy/raw lines fail closed.
    // Paths exclude decoded query delimiters, percent escapes, quotes and controls.
    // Upstream timing lists remain strings (including empty/missing, '-' and retries).
    stage.regex {
      expression = `^(?P<safe_gateway>\{"time":"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}","method":"(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS|UNKNOWN)","uri":"/[a-zA-Z0-9/_.~!$&'()*+,;=:@+-]{0,1000}[a-zA-Z0-9/_.~!$&'()*+,;=:@+-]{0,1000}[a-zA-Z0-9/_.~!$&'()*+,;=:@+-]{0,47}","status":[1-5][0-9]{2},"request_time":[0-9]{1,10}\.[0-9]{3},"upstream_response_time":"[0-9.,: -]{0,256}","upstream_connect_time":"[0-9.,: -]{0,256}","upstream_header_time":"[0-9.,: -]{0,256}","upstream_addr":"[0-9a-fA-F.:\[\], -]{0,512}","bytes_sent":[0-9]{1,20}\})$`
    }
    stage.template {
      source   = "safe_gateway"
      template = `{{ if .Value }}{{ .Value }}{{ else }}{"service":"rusys-gateway","event":"gateway_output_redacted"}{{ end }}`
    }
    stage.output {
      source = "safe_gateway"
    }
  }
  stage.match {
    selector = `{service_name="monitoring"}`
    stage.regex {
      expression = `(?:^| )level=(?P<severity>debug|info|warn|error)(?: |$)`
    }
    stage.template {
      source   = "safe_infra"
      template = `{"service":"monitoring","event":"monitoring_output_redacted","level":"{{ if .severity }}{{ .severity }}{{ else }}unknown{{ end }}"}`
    }
    stage.output {
      source = "safe_infra"
    }
  }
  stage.label_keep {
    values = ["project", "environment", "host", "service_name", "container", "slot", "stream"]
  }
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GC_LOKI_URL")

    basic_auth {
      username = sys.env("GC_LOKI_USER")
      password = sys.env("GC_LOKI_TOKEN")
    }
  }
}
