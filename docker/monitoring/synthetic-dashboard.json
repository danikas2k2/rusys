{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "fieldConfig": {
        "defaults": {
          "noValue": "No recent check",
          "mappings": [
            {
              "options": { "0": { "color": "red", "text": "Down" }, "1": { "color": "green", "text": "Up" } },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "editorMode": "code",
          "expr": "min by (job) (last_over_time(probe_success{job=~\"rusys-homepage|rusys-health\"}[6m]))",
          "instant": true,
          "legendFormat": "{{job}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Current availability",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "fieldConfig": { "defaults": { "unit": "dateTimeAsIso" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "editorMode": "code",
          "expr": "1000 * max by (job) (max_over_time(timestamp(probe_success{job=~\"rusys-homepage|rusys-health\"})[15m:1m]))",
          "instant": true,
          "legendFormat": "{{job}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Last check",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 99 },
              { "color": "green", "value": 99.9 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "editorMode": "code",
          "expr": "100 * sum by (job) (sum_over_time(probe_success{job=~\"rusys-homepage|rusys-health\"}[$__range])) / sum by (job) (count_over_time(probe_success{job=~\"rusys-homepage|rusys-health\"}[$__range]))",
          "instant": true,
          "legendFormat": "{{job}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Uptime over selected range",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 7 },
      "id": 4,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "editorMode": "code",
          "expr": "max by (job) (probe_duration_seconds{job=~\"rusys-homepage|rusys-health\"})",
          "legendFormat": "{{job}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Response time",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": { "0": { "color": "red", "text": "Failed" }, "1": { "color": "green", "text": "Succeeded" } },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 16 },
      "id": 5,
      "options": {
        "alignValue": "center",
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "mergeValues": false,
        "rowHeight": 0.9,
        "showValue": "always",
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "editorMode": "code",
          "expr": "min by (job) (min_over_time(probe_success{job=~\"rusys-homepage|rusys-health\"}[$__interval]))",
          "interval": "5m",
          "legendFormat": "{{job}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Check history and incidents",
      "type": "state-timeline"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["rusys", "synthetic-monitoring"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Prometheus data source",
        "multi": false,
        "name": "prometheus",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Rusys synthetic uptime",
  "uid": "rusys-synthetic-uptime",
  "version": 1
}
