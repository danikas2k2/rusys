{
    "extends": "@tsconfig/node18",
    "include": ["src/**/*"],
    "exclude": ["node_modules", "**/*.spec.ts", "src/server/**/*"],
    "compilerOptions": {
        "module": "node16",
        "moduleResolution": "node16",
        "moduleDetection": "force",
        "target": "esnext",
        "baseUrl": ".",
        "paths": {
            "@icons/*": ["src/icons/*"],
            "@ui/*": ["src/ui/*"],
            "~/*": ["src/*"]
        },
        "lib": ["es2023", "dom", "dom.iterable"],
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "noFallthroughCasesInSwitch": true,
        "resolveJsonModule": true,
        "downlevelIteration": true,
        "verbatimModuleSyntax": false,
        "jsx": "react-jsx",
        "preserveSymlinks": true,
        "types": [
            "node",
            "express",
            "mdx",
            "jest",
            "jest-extended",
            "jest-chain",
            "jest-to-match-shape-of",
            "jest-expect-message"
        ],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "ts-node": {
        "esm": true,
        "compilerOptions": {
            "target": "es2022",
            "module": "node16",
            "moduleResolution": "node16",
            "verbatimModuleSyntax": false
        }
    }
}
