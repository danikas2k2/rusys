{
    "singleQuote": true,
    "tabWidth": 4,
    "printWidth": 120,
    "trailingComma": "es5",
    "overrides": [
        {
            "files": [
                "*.html",
                "*.less"
            ],
            "options": {
                "singleQuote": false
            }
        },
        {
            "files": [
                "*.config.js",
                "*.config.ts",
                "*.config.mjs"
            ],
            "options": {
                "printWidth": 80
            }
        },
        {
            "files": [
                "webpack.config.ts",
                "webpack.*.config.ts"
            ],
            "options": {
                "printWidth": 120
            }
        }
    ]
}
