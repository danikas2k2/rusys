{
    "name": "rusys",
    "version": "3.3.3",
    "private": true,
    "main": "index.js",
    "description": "",
    "keywords": [],
    "author": "danikas2k2@gmail.com",
    "license": "ISC",
    "repository": {
        "type": "git",
        "url": "https://github.com/danikas2k2/rusys.git"
    },
    "engines": {
        "node": "^24.0.0",
        "pnpm": "^10.0.0",
        "npm": "please-use-pnpm",
        "yarn": "please-use-pnpm"
    },
    "scripts": {
        "start": "cd dist && node server.js",
        "start:local": "dotenv -e .env.prod.local -- pnpm start",
        "assets": "pnpm assets:splash && pnpm assets:icons && pnpm assets:format",
        "assets:splash": "pwa-asset-generator public/assets/logo.svg public/assets --padding 'calc(50vh - 20vw) calc(50vw - 20vh)' --type png --opaque false --splash-only --path-override /assets --index ./public/index.html --xhtml",
        "assets:icons": "pwa-asset-generator public/assets/logo.svg public/assets --padding '1%' --type png --opaque false --icon-only --favicon --mstile --manifest ./public/manifest.json --path-override /assets --index ./public/index.html --xhtml",
        "assets:format": "prettier --write ./public/index.html ./public/manifest.json",
        "build": "pnpm build:client && pnpm build:server",
        "build:client": "vite build --config vite.client.config.ts --mode production",
        "build:server": "vite build --config vite.server.config.ts --mode production",
        "deploy": "pnpm check && pnpm build && pnpm deploy:production",
        "deploy:production": "dotenv -e .env.deploy.local -- vite build --config vite.deploy.config.ts --mode production",
        "dev": "dotenv -e .env.local -- npm-run-all --parallel dev:server dev:client",
        "dev:server": "ts-node --transpile-only --require tsconfig-paths/register src/server/dev.ts",
        "dev:client": "vite",
        "check": "pnpm lint && pnpm test",
        "lint": "pnpm run lint:ts && pnpm run lint:es && pnpm run lint:styles",
        "lint:ts": "tsc --noEmit",
        "lint:es": "eslint src",
        "lint:styles": "stylelint src/**/*.pcss",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "version": "sed -i '' 's/APP_VERSION: \".*\"/APP_VERSION: \"'\"$npm_package_version\"'\"/' ./docker/compose.yaml && git add --all",
        "preversion": "git pull",
        "postversion": "git push && git push --tags",
        "update-deps": "syncpack update && pnpm install"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all",
            "not ie <= 11",
            "iOS >= 10"
        ],
        "development": [
            "last 5 versions"
        ]
    },
