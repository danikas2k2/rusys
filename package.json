        "@mantine/dates": "^9.6.1",
        "@mantine/dropzone": "^9.6.1",
        "@mantine/form": "^9.6.1",
        "@mantine/hooks": "^9.6.1",
        "@react-oauth/google": "^0.13.5",
        "@reduxjs/toolkit": "^2.12.0",
