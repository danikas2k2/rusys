{
    "name": "rusys",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "start": "concurrently --kill-others \"less-watch-compiler --config less-watcher.config.json\" \"react-app-rewired start\"",
        "start-ssl": "HTTPS=true SSL_CRT_FILE=cert.crt SSL_KEY_FILE=cert.key yarn start",
        "start-server": "ts-node -r tsconfig-paths/register src/server.ts",
        "build": "react-scripts build",
        "test": "react-scripts test",
        "eject": "react-scripts eject"
    },
    "eslintConfig": {
        "extends": [
            "react-app",
            "react-app/jest"
        ],
        "rules": {
            "react-hooks/exhaustive-deps": "error"
        }
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "browser": {
        "@config": false
    },
    "dependencies": {
        "@emotion/react": "^11.10.0",
        "@emotion/styled": "^11.10.0",
        "@mui/icons-material": "^5.8.4",
        "@mui/material": "^5.9.3",
        "@mui/types": "^7.1.5",
        "classnames": "^2.3.1",
        "cors": "^2.8.5",
        "lodash": "^4.17.21",
        "moment": "^2.29.4",
        "nedb-promises": "^6.1.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-google-login": "^5.2.2",
        "react-redux": "^8.0.2",
        "react-scripts": "^5.0.1",
        "redux": "^4.2.0",
        "redux-thunk": "^2.4.1",
        "web-vitals": "^2.1.4"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^5.16.4",
        "@testing-library/react": "^13.3.0",
        "@testing-library/user-event": "^14.4.1",
        "@types/cors": "^2.8.12",
        "@types/jest": "^28.1.6",
        "@types/lodash": "^4.14.182",
        "@types/nedb": "^1.8.12",
        "@types/node": "^18.6.3",
        "@types/react": "^18.0.15",
        "@types/react-dom": "^18.0.6",
        "concurrently": "^7.3.0",
        "less": "^4.1.3",
        "less-watch-compiler": "^1.16.3",
        "prettier": "^2.7.1",
        "react-app-rewire-alias": "^1.1.7",
        "react-app-rewired": "^2.2.1",
        "redux-devtools": "^3.7.0",
        "ts-node": "^10.9.1",
        "tsconfig-paths": "^4.0.0",
        "tslib": "^2.4.0",
        "typescript": "^4.7.4"
    },
    "prettier": {
        "singleQuote": true,
        "tabWidth": 4,
        "printWidth": 120,
        "trailingComma": "es5"
    }
}
