    },
    "engines": {
        "node": "^18.0.0 || ^20.0.0 || ^22.0.0",
        "yarn": "please-use-pnpm",
        "npm": "please-use-pnpm",
        "pnpm": "^8.0.0 || ^9.0.0"
    },
    "scripts": {
        "start": "cd dist && esr server.js",
        "build": "npm-run-all --parallel build:server build:client",
        "build:client": "webpack --config webpack.config.ts --mode production --progress && pnpm build:client:cleanup",
        "build:client:cleanup": "rm -rf dist/**/*.LICENSE.txt && if [ -f dist/public/package.json ]; then mv -n dist/public/package.json dist/; fi",
        "build:server": "esbuild src/server/index.ts --bundle --minify --platform=node --target=node20 --external:express --external:cors --external:body-parser --external:moment --external:nedb-promises --outfile=dist/server.js",
        "build:tutorial": "webpack --config webpack.tutorial.config.ts --mode production --progress",
        "dev": "esr src/server/dev.ts --platform=node --target=node20 --external:express --external:cors --external:body-parser --external:moment --external:nedb-promises",
        "dev:watch": "npm-run-all --parallel dev:watch:client dev:watch:server",
        "dev:watch:client": "NODE_ENV=development webpack --config webpack.dev.config.ts --mode development --watch",
        "dev:watch:server": "pnpm run dev:build:server && NODE_ENV=development node ./dist/dev.js",
        "dev:build": "npm-run-all --parallel dev:build:client dev:build:server",
        "dev:build:client": "NODE_ENV=development webpack --config webpack.dev.config.ts --mode development",
        "dev:build:server": "NODE_ENV=development esbuild src/server/dev.ts --bundle --sourcemap --platform=node --target=node20 --external:express --external:cors --external:body-parser --external:moment --external:nedb-promises --external:webpack --external:webpack-* --external:*-webpack-plugin --external:mini-css-extract-plugin --outfile=dist/dev.js",
        "dev:all": "npm-run-all --parallel dev:ts dev:start",
        "dev:start-bak": "NODE_ENV=development DB=mongodb://rusiodb1:30201,rusiodb2:30202,rusiodb3:30203/rusys?replicaSet=rusiors esr src/server/dev.ts --platform=node --target=node20 --external:express --external:cors --external:body-parser --external:moment --external:nedb-promises",
        "dev:start": "NODE_ENV=development DB=mongodb://rusiodb1:30201,rusiodb2:30202,rusiodb3:30203/rusys?replicaSet=rusiors pnpm dev",
        "dev:tutorial": "NODE_ENV=development webpack serve --config webpack.tutorial.config.ts --mode development",
        "dev:ts": "tsc --watch --noEmit",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "remote:upload": "rsync -avr --exclude \"tutorial.*\" --exclude \"data\" ./dist/* dan@vd:/var/www/rusys/",
        "remote:restart": "ssh dan@vd \"pm2 restart rusys --update-env\"",
        "deploy": "pnpm test && pnpm build && pnpm remote:upload && pnpm remote:restart",
        "preversion": "git pull && pnpm test",
        "version": "pnpm run build && git add --all && git commit -m \"$npm_package_version\"",
        "postversion": "git push && git push --tags",
        "migrate": "DATA_PATH=/Users/asteponavicius/dev/rusys/data DB=mongodb://rusiodb1:30201,rusiodb2:30202,rusiodb3:30203/rusys?replicaSet=rusiors esr src/server/db-migrate.ts --platform=node --target=node20 --external:express --external:cors --external:body-parser --external:moment --external:nedb-promises"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
