{
    "name": "rusys",
    "version": "3.12.0",
    "private": true,
    "description": "",
    "keywords": [],
    "license": "ISC",
    "author": "danikas2k2@gmail.com",
    "repository": {
        "type": "git",
        "url": "https://github.com/danikas2k2/rusys.git"
    },
    "main": "index.js",
    "scripts": {
        "start": "cd dist/server && node server.js",
        "start:local": "dotenv -e .env.prod.local -- pnpm start",
        "prebuild": "rm -rf dist",
        "build": "turbo run build --filter='!rusys'",
        "deploy": "pnpm check && pnpm build && pnpm deploy:run",
        "deploy:run": "dotenv -e .env.deploy.local -- vite build --config vite.deploy.config.mts --mode production",
        "deploy:rollback": "dotenv -e .env.deploy.local -- vite build --config vite.rollback.config.mts --mode production",
        "dev": "dotenv -e .env.local -- turbo run dev --filter='!rusys'",
        "check": "turbo run check --filter='!rusys'",
        "lint": "turbo run lint --filter='!rusys'",
        "lint:ts": "turbo run lint:ts --filter='!rusys' && tsc --noEmit -p tsconfig.node.json",
        "lint:es": "eslint",
        "lint:styles": "stylelint \"src/**/*.pcss\"",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "turbo run test --filter='!rusys'",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "preversion": "git pull && pnpm check",
        "version": "sed -i '' 's/APP_VERSION: \".*\"/APP_VERSION: \"'\"$npm_package_version\"'\"/' ./docker/compose.yaml && git add docker/compose.yaml",
        "postversion": "git push && git push --tags",
        "update-deps": "pnpm -r update --latest && syncpack update && pnpm install"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/sortable": "^10.0.0",
