        "stylelint-config-standard": "^40.0.0",
        "stylelint-prettier": "^5.0.3",
        "supertest": "^7.2.2",
        "syncpack": "^15.3.2",
        "terser": "^5.49.0",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.64.0",
        "vite": "^8.1.5",
        "vite-plugin-html": "^3.2.2",
        "vite-plugin-svgr": "^5.2.0"
    }
}
