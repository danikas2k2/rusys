        "@tsconfig/node26": "^26.0.0",
        "@types/blueimp-md5": "^2.18.2",
        "@types/body-parser": "^1.19.6",
        "@types/busboy": "^1.5.4",
        "@types/cors": "^2.8.19",
        "@types/eslint-plugin-jsx-a11y": "^6.10.1",
        "@types/express": "^5.0.6",
        "@types/express-fileupload": "^1.5.1",
        "@types/express-serve-static-core": "^5.1.2",
        "@types/jest": "^30.0.0",
        "@types/jsdom": "^28.0.3",
