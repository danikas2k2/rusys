{
    "name": "rusys",
    "version": "4.1.4",
    "private": true,
    "description": "",
    "keywords": [],
    "license": "ISC",
    "author": "danikas2k2@gmail.com",
    "repository": {
        "type": "git",
        "url": "https://github.com/danikas2k2/rusys.git"
    },
    "main": "index.js",
    "scripts": {
        "start": "next start",
        "start:local": "dotenv -e .env.prod.local -- pnpm start",
        "build": "next build",
        "deploy": "pnpm check && pnpm deploy:run",
        "deploy:run": "dotenv -e .env.deploy.local -- tsx scripts/deploy-runner.ts deploy",
        "deploy:rollback": "dotenv -e .env.deploy.local -- tsx scripts/deploy-runner.ts rollback",
        "dev": "dotenv -e .env.local -- next dev",
        "assets": "pnpm assets:prepare && pnpm assets:splash && pnpm assets:icons && pnpm assets:metadata && pnpm assets:compress",
        "assets:prepare": "rm -f public/assets/apple-icon-180.png public/assets/apple-splash-*.png public/assets/favicon-196.png public/assets/manifest-icon-*.png public/assets/mstile-icon-*.png",
        "assets:splash": "pnpm assets:splash:dark && pnpm assets:splash:light",
        "assets:splash:light": "pwa-asset-generator public/assets/logo.svg public/assets --padding 'calc(50vh - 20vw) calc(50vw - 20vh)' --type png --background '#eff1f5' --splash-only --log false",
        "assets:splash:dark": "pwa-asset-generator public/assets/logo.svg public/assets --padding 'calc(50vh - 20vw) calc(50vw - 20vh)' --type png --background '#1e1e2e' --splash-only --dark-mode --log false",
        "assets:icons": "pwa-asset-generator public/assets/logo.svg public/assets --padding '1%' --type png --opaque false --icon-only --favicon --mstile --manifest public/manifest.json --path-override /assets --log false",
        "assets:metadata": "tsx scripts/generate-pwa-assets.ts && prettier --write public/manifest.json src/app/pwa-assets.json",
        "assets:compress": "tsx scripts/optimize-pwa-assets.ts",
        "check": "pnpm lint && pnpm test",
        "check:all": "pnpm lint && pnpm test:coverage && pnpm test:visual && pnpm test:e2e",
        "lint": "pnpm format:check && pnpm lint:ts && pnpm lint:es && pnpm lint:styles",
        "lint:ts": "tsc --noEmit",
        "lint:es": "eslint",
        "lint:styles": "stylelint \"src/**/*.css\"",
        "format": "prettier --cache --write .",
        "format:check": "prettier --cache --check .",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "test:e2e": "playwright test --grep '\\.spec\\.ts'",
        "test:e2e:critical": "playwright test --grep @critical --grep-invert '\\.snap\\.ts'",
        "test:e2e:headed": "playwright test --grep '\\.spec\\.ts' --headed",
        "test:e2e:ui": "playwright test --grep '\\.spec\\.ts' --ui",
        "test:visual": "env PLAYWRIGHT_VISUAL=1 playwright test --grep '\\.snap\\.ts'",
        "test:visual:update": "env PLAYWRIGHT_VISUAL=1 playwright test --grep '\\.snap\\.ts' --update-snapshots",
        "preversion": "git pull && pnpm check",
        "version": "sed -i '' 's/APP_VERSION: \".*\"/APP_VERSION: \"'\"$npm_package_version\"'\"/' ./docker/compose.yaml && git add docker/compose.yaml",
        "postversion": "git push && git push --tags",
        "update-deps": "pnpm -r update --latest && syncpack update && pnpm install"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@mantine/core": "^9.6.3",
        "@mantine/dates": "^9.6.3",
        "@mantine/dropzone": "^9.6.3",
        "@mantine/form": "^9.6.3",
        "@mantine/hooks": "^9.6.3",
        "@react-oauth/google": "^0.13.5",
        "@reduxjs/toolkit": "^2.13.0",
        "@tabler/icons-react": "^3.48.0",
        "ajv": "^8.20.0",
        "blueimp-md5": "^2.19.0",
        "dayjs": "^1.11.23",
        "fast-deep-equal": "^3.1.3",
        "google-auth-library": "^11.1.0",
        "jszip": "^3.10.2",
        "lodash": "^4.18.1",
        "mongodb": "^7.7.0",
        "next": "^16.3.8",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-error-boundary": "^6.1.6",
        "react-redux": "^9.3.0",
        "redux": "^5.0.1",
        "sharp": "^0.35.5",
        "transliteration": "^2.6.1"
    },
    "devDependencies": {
        "@catppuccin/palette": "^1.8.0",
        "@css-modules-kit/stylelint-plugin": "^1.4.0",
        "@csstools/postcss-relative-color-syntax": "^4.0.14",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@playwright/test": "^1.63.0",
        "@stylistic/stylelint-plugin": "^5.3.1",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@tsconfig/node26": "^26.0.1",
        "@types/blueimp-md5": "^2.18.2",
        "@types/eslint-plugin-jsx-a11y": "^6.10.1",
        "@types/lodash": "^4.17.25",
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.71.0",
        "@typescript-eslint/parser": "^8.71.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitest/coverage-v8": "^5.0.3",
        "@vitest/eslint-plugin": "^1.6.27",
        "@vitest/expect": "^5.0.3",
        "@vitest/ui": "^5.0.3",
        "autoprefixer": "^10.6.1",
        "classnames": "^2.5.1",
        "dotenv-cli": "^11.0.0",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-functional": "^10.0.1",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-compiler": "19.1.0-rc.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "immer": "^11.1.18",
        "jsdom": "^30.1.1",
        "mingo": "^7.2.4",
        "mongodb-memory-server": "^11.3.0",
        "mongodb-memory-server-core": "^11.3.0",
        "playwright": "1.63.0",
        "playwright-core": "1.63.0",
        "postcss": "^8.5.28",
        "postcss-discard-comments": "^9.0.5",
        "postcss-import": "^17.0.0",
        "postcss-less": "^6.0.0",
        "postcss-preset-env": "^11.5.5",
        "postcss-preset-mantine": "^1.18.0",
        "postcss-simple-vars": "^7.0.1",
        "prettier": "^3.9.9",
        "pwa-asset-generator": "^8.1.7",
        "redux-thunk": "^3.1.0",
        "reselect": "^5.3.0",
        "rolldown": "^1.2.12",
        "stylelint": "^17.16.0",
        "stylelint-config-recommended": "^18.0.0",
        "stylelint-config-standard": "^40.0.0",
        "syncpack": "^15.3.3",
        "tsx": "^4.23.15",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "vite": "^8.3.2",
        "vitest": "^5.0.3"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all",
            "not ie <= 11",
            "iOS >= 10"
        ],
        "development": [
            "last 5 versions"
        ]
    },
    "engines": {
        "node": ">=24",
        "npm": "please-use-pnpm",
        "pnpm": ">=9",
        "yarn": "please-use-pnpm"
    },
    "packageManager": "pnpm@11.24.0"
}
