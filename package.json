    "author": "danikas2k2@gmail.com",
    "license": "ISC",
    "repository": {
        "type": "git",
        "url": "https://github.com/danikas2k2/rusys.git"
    },
    "scripts": {
        "start": "cd dist && esr server.js",
        "build": "npm-run-all --parallel build:server build:client",
        "build:client": "webpack --config webpack.config.ts --mode production --progress && pnpm build:client:cleanup",
        "build:client:cleanup": "rm -rf dist/**/*.LICENSE.txt && if [ -f dist/public/package.json ]; then mv -n dist/public/package.json dist/; fi",
        "build:server": "esbuild src/server/index.ts --bundle --minify --platform=node --target=node18 --external:express --external:cors --external:body-parser --external:moment --external:nedb-promises --outfile=dist/server.js",
        "build:tutorial": "webpack --config webpack.tutorial.config.ts --mode production --progress",
        "dev": "esr src/server/dev.ts --platform=node --target=node18 --external:express --external:cors --external:body-parser --external:moment --external:nedb-promises",
        "dev:watch": "npm-run-all --parallel dev:watch:client dev:watch:server",
        "dev:watch:client": "NODE_ENV=development webpack --config webpack.dev.config.ts --mode development --watch",
        "dev:watch:server": "pnpm run dev:build:server && NODE_ENV=development node ./dist/dev.js",
        "dev:build": "npm-run-all --parallel dev:build:client dev:build:server",
        "dev:build:client": "NODE_ENV=development webpack --config webpack.dev.config.ts --mode development",
        "dev:build:server": "NODE_ENV=development esbuild src/server/dev.ts --bundle --sourcemap --platform=node --target=node18 --external:express --external:cors --external:body-parser --external:moment --external:nedb-promises --external:webpack --external:webpack-* --external:*-webpack-plugin --external:mini-css-extract-plugin --outfile=dist/dev.js",
        "dev:tutorial": "NODE_ENV=development webpack serve --config webpack.tutorial.config.ts --mode development",
        "test": "jest",
        "coverage": "jest --coverage",
        "remote:upload": "rsync -avr --exclude \"tutorial.*\" --exclude \"data\" ./dist/* dan@vd:/var/www/rusys/",
        "remote:restart": "ssh dan@vd \"pm2 restart rusys --update-env\"",
        "deploy": "pnpm test && pnpm build && pnpm remote:upload && pnpm remote:restart",
        "preversion": "git pull && pnpm test",
        "version": "pnpm run build && git add --all && git commit -m \"$npm_package_version\"",
        "postversion": "git push && git push --tags"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
