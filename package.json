    "scripts": {
        "start": "cd dist && esr server.js",
        "build": "npm-run-all --parallel build:server build:client",
        "build:client": "webpack --config webpack.config.ts --mode production --progress && pnpm build:client:cleanup",
        "build:client:cleanup": "rm -rf dist/**/*.LICENSE.txt && if [ -f dist/public/package.json ]; then mv dist/public/package.json dist/; fi",
        "build:server": "esbuild src/server/index.ts --bundle --minify --platform=node --target=node22 --external:express --external:cors --external:body-parser --external:moment --external:mongodb --outfile=dist/server.js",
        "build:safe": "pnpm check && pnpm build",
        "build:tutorial": "webpack --config webpack.tutorial.config.ts --mode production --progress",
        "dev": "NODE_ENV=development DB=mongodb://rusiodb1:30201,rusiodb2:30202,rusiodb3:30203/rusys?replicaSet=rusiors HTTPS_KEY=certs/key.pem HTTPS_CERT=certs/cert.pem pnpm dev:start",
        "dev:ts": "tsc --watch --noEmit",
        "dev:start": "esr src/server/dev.ts --platform=node --target=node22 --external:express --external:cors --external:body-parser --external:moment --external:mongodb",
        "dev:tutorial": "NODE_ENV=development webpack serve --config webpack.tutorial.config.ts --mode development",
        "check": "pnpm lint && pnpm test",
        "lint": "pnpm run lint:ts && pnpm run lint:es",
        "lint:ts": "tsc --noEmit",
        "lint:es": "eslint src",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "remote:upload": "rsync -avr --exclude \"tutorial.*\" --exclude \"data\" ./dist/* dan@vd:/var/www/rusys/",
        "remote:restart": "ssh dan@vd \"pm2 restart rusys --update-env\"",
        "deploy": "pnpm build:safe && bin/deploy.sh",
        "preversion": "git pull",
        "version": "sed -i '' 's/APP_VERSION: \".*\"/APP_VERSION: \"'\"$npm_package_version\"'\"/' ./docker/compose.yaml && git add --all",
        "postversion": "git push && git push --tags",
        "update-deps": "syncpack update && pnpm install"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all",
            "not ie <= 11",
            "iOS >= 10"
        ],
        "development": [
            "last 5 versions"
        ]
    },
