{
    "name": "rusys",
    "version": "3.10.7",
    "private": true,
    "description": "",
    "keywords": [],
    "license": "ISC",
    "author": "danikas2k2@gmail.com",
    "repository": {
        "type": "git",
        "url": "https://github.com/danikas2k2/rusys.git"
    },
    "main": "index.js",
    "scripts": {
        "start": "cd dist && node server.js",
        "start:local": "dotenv -e .env.prod.local -- pnpm start",
        "assets": "pnpm assets:splash && pnpm assets:icons && pnpm assets:compress",
        "assets:splash": "pnpm assets:splash:dark && pnpm assets:splash:light",
        "assets:splash:light": "pwa-asset-generator public/assets/logo.svg public/assets --padding 'calc(50vh - 20vw) calc(50vw - 20vh)' --type png --background '#eff1f5' --splash-only --path-override /assets --index ./templates/splash.html --xhtml",
        "assets:splash:dark": "pwa-asset-generator public/assets/logo.svg public/assets --padding 'calc(50vh - 20vw) calc(50vw - 20vh)' --type png --background '#1e1e2e' --splash-only --dark-mode --path-override /assets --index ./templates/splash.html --xhtml",
        "assets:icons": "pwa-asset-generator public/assets/logo.svg public/assets --padding '1%' --type png --opaque false --icon-only --favicon --mstile --manifest ./public/manifest.json --path-override /assets --index ./templates/icons.html --xhtml",
        "assets:compress": "oxipng -o 4 public/assets/*.png",
        "build": "pnpm build:client && pnpm build:server",
        "build:client": "NODE_ENV=production vite build --config vite.client.config.mts --mode production",
        "build:server": "vite build --config vite.server.config.mts --mode production",
        "deploy": "pnpm check && pnpm deploy:nocheck",
        "deploy:nocheck": "pnpm build && pnpm deploy:production",
        "deploy:production": "dotenv -e .env.deploy.local -- vite build --config vite.deploy.config.mts --mode production",
        "deploy:rollback": "dotenv -e .env.deploy.local -- vite build --config vite.rollback.config.mts --mode production",
        "dev": "dotenv -e .env.local -- npm-run-all --parallel dev:server dev:client",
        "dev:server": "ts-node --transpile-only --require tsconfig-paths/register --project tsconfig.server.json src/server/dev.ts",
        "dev:client": "vite",
        "check": "pnpm lint && pnpm test",
        "lint": "pnpm run lint:ts && pnpm run lint:ox && pnpm run format:check && pnpm run lint:styles",
        "lint:ts": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
        "lint:ox": "oxlint --format stylish src",
        "lint:styles": "stylelint \"src/**/*.pcss\"",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "test": "MONGOMS_VERSION=6.0.14 vitest run",
        "test:coverage": "vitest run --coverage",
        "test:ui": "MONGOMS_VERSION=6.0.14 vitest --ui",
        "test:watch": "MONGOMS_VERSION=6.0.14 vitest",
        "preversion": "git pull && pnpm check",
        "version": "sed -i '' 's/APP_VERSION: \".*\"/APP_VERSION: \"'\"$npm_package_version\"'\"/' ./docker/compose.yaml && git add --all",
        "postversion": "git push && git push --tags",
        "update-deps": "pnpm update --latest && syncpack update"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@mantine/core": "^9.5.2",
        "@mantine/dates": "^9.5.2",
        "@mantine/dropzone": "^9.5.2",
        "@mantine/form": "^9.5.2",
        "@mantine/hooks": "^9.5.2",
        "@react-oauth/google": "^0.13.5",
        "@reduxjs/toolkit": "^2.12.0",
        "@tabler/icons-react": "^3.46.0",
        "@vitest/expect": "^4.1.11",
        "ajv": "^8.20.0",
        "axios": "^1.20.0",
        "blueimp-md5": "^2.19.0",
        "body-parser": "^2.3.0",
        "cors": "^2.8.6",
        "dayjs": "^1.11.23",
        "express": "^5.2.1",
        "express-fileupload": "^1.5.2",
        "fast-deep-equal": "^3.1.3",
        "helmet": "^8.3.0",
        "jszip": "^3.10.1",
        "jwt-decode": "^4.0.0",
        "lodash": "^4.18.1",
        "mongodb": "^7.6.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-error-boundary": "^6.1.3",
        "react-redux": "^9.3.0",
        "react-router": "^8.3.0",
        "redux": "^5.0.1",
        "sharp": "^0.35.4",
        "transliteration": "^2.6.1"
    },
    "devDependencies": {
        "@catppuccin/palette": "^1.8.0",
        "@css-modules-kit/stylelint-plugin": "^1.4.0",
        "@csstools/postcss-relative-color-syntax": "^4.0.9",
        "@stylistic/stylelint-plugin": "^5.3.0",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.6",
        "@tsconfig/node26": "^26.0.1",
        "@types/blueimp-md5": "^2.18.2",
        "@types/body-parser": "^1.19.6",
        "@types/busboy": "^1.5.4",
        "@types/chai": "^5.2.3",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/express-fileupload": "^1.5.1",
        "@types/express-serve-static-core": "^5.1.3",
        "@types/lodash": "^4.17.25",
        "@types/node": "^26.3.0",
        "@types/postcss-import": "^14.0.3",
        "@types/qs": "^6.15.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@types/serve-static": "^2.2.0",
        "@types/superagent": "^8.1.11",
        "@types/supertest": "^7.2.1",
        "@vitejs/plugin-react": "^6.1.0",
        "@vitest/coverage-v8": "^4.1.11",
        "@vitest/expect": "^4.1.11",
        "@vitest/ui": "^4.1.11",
        "autoprefixer": "^10.5.4",
        "classnames": "^2.5.1",
        "dotenv-cli": "^11.0.0",
        "esbuild": "^0.28.2",
        "jiti": "^2.7.0",
        "jsdom": "^30.0.1",
        "mongodb-memory-server": "^11.2.0",
        "mongodb-memory-server-core": "^11.2.0",
        "npm-run-all": "^4.1.5",
        "oxfmt": "^0.65.0",
        "oxlint": "^1.80.0",
        "postcss": "^8.5.26",
        "postcss-discard-comments": "^8.0.4",
        "postcss-html": "^2.0.0",
        "postcss-import": "^17.0.0",
        "postcss-jsx": "^0.36.4",
        "postcss-less": "^6.0.0",
        "postcss-nested": "^8.0.1",
        "postcss-preset-env": "^11.5.0",
        "postcss-preset-mantine": "^1.18.0",
        "postcss-scss": "^4.0.9",
        "postcss-simple-vars": "^7.0.1",
        "postcss-syntax": "^0.36.2",
        "pwa-asset-generator": "^8.1.5",
        "react-router-dom": "^7.18.2",
        "stylelint": "^17.14.1",
        "stylelint-config-recommended": "^18.0.0",
        "stylelint-config-standard": "^40.0.0",
        "supertest": "^7.2.2",
        "syncpack": "^15.3.3",
        "terser": "^5.51.0",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "7.0.2",
        "vite": "^8.2.2",
        "vite-plugin-html": "^3.2.2",
        "vite-plugin-svgr": "^5.2.0",
        "vitest": "^4.1.11"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all",
            "not ie <= 11",
            "iOS >= 10"
        ],
        "development": [
            "last 5 versions"
        ]
    },
    "engines": {
        "node": ">=24",
        "npm": "please-use-pnpm",
        "pnpm": ">=9",
        "yarn": "please-use-pnpm"
    }
}
