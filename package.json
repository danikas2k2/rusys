{
    "name": "rusys",
    "version": "0.2.0",
    "private": true,
    "scripts": {
        "start:server": "ts-node -r tsconfig-paths/register src/server/index.ts",
        "start:client": "concurrently --kill-others \"less-watch-compiler --config less-watcher.config.json\" \"react-app-rewired start\"",
        "start": "npm-run-all --parallel start:*",
        "--start:client:ssl": "HTTPS=true SSL_CRT_FILE=cert.crt SSL_KEY_FILE=cert.key yarn start",
        "build:server": "esbuild src/server/index.ts --bundle --platform=node --target=node16 --external:./config.js --external:./node_modules/* --outfile=build/server.js",
        "build:client": "react-app-rewired build",
        "build": "npm-run-all --parallel build:*",
        "test": "react-app-rewired test",
        "eject": "react-app-rewired eject",
        "--preversion": "npm test",
        "version": "npm run build && git add --all",
        "postversion": "git push && git push --tags"
    },
    "eslintConfig": {
        "extends": [
            "react-app",
            "react-app/jest"
        ],
        "rules": {
            "react-hooks/exhaustive-deps": "error",
            "@typescript-eslint/consistent-type-imports": "error"
        }
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "browser": {
        "@config": false
    },
    "dependencies": {
        "@emotion/react": "^11.10.4",
        "@emotion/styled": "^11.10.4",
        "@mui/icons-material": "^5.10.6",
        "@mui/material": "^5.10.6",
        "@mui/types": "^7.2.0",
        "classnames": "^2.3.2",
        "cors": "^2.8.5",
        "lodash": "^4.17.21",
        "moment": "^2.29.4",
        "nedb-promises": "^6.1.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-google-login": "^5.2.2",
        "react-redux": "^8.0.4",
        "react-scripts": "^5.0.1",
        "redux": "^4.2.0",
        "redux-thunk": "^2.4.1",
        "web-vitals": "^3.0.2"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^5.16.5",
        "@testing-library/react": "^13.4.0",
        "@testing-library/user-event": "^14.4.3",
        "@tsconfig/node16": "^1.0.3",
        "@types/cors": "^2.8.12",
        "@types/jest": "^29.0.3",
        "@types/lodash": "^4.14.185",
        "@types/nedb": "^1.8.12",
        "@types/node": "^18.7.18",
        "@types/react": "^18.0.21",
        "@types/react-dom": "^18.0.6",
        "concurrently": "^7.4.0",
        "esbuild": "^0.15.12",
        "less": "^4.1.3",
        "less-watch-compiler": "^1.16.3",
        "prettier": "^2.7.1",
        "react-app-rewire-alias": "^1.1.7",
        "react-app-rewired": "^2.2.1",
        "redux-devtools": "^3.7.0",
        "ts-node": "^10.9.1",
        "tsconfig-paths": "^4.1.0",
        "tslib": "^2.4.0",
        "typescript": "^4.8.3",
        "yarn-run-all": "^3.1.1"
    },
    "prettier": {
        "singleQuote": true,
        "tabWidth": 4,
        "printWidth": 120,
        "trailingComma": "es5"
    }
}
