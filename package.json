        "mongodb-memory-server-core": "^11.2.0",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.5.28",
        "postcss-discard-comments": "^9.0.2",
        "postcss-html": "^2.0.0",
        "postcss-import": "^17.0.0",
