{
    "name": "rusys",
    "version": "3.5.1",
    "private": true,
    "main": "index.js",
    "description": "",
    "keywords": [],
    "author": "danikas2k2@gmail.com",
    "license": "ISC",
    "repository": {
        "type": "git",
        "url": "https://github.com/danikas2k2/rusys.git"
    },
    "engines": {
        "node": ">=26",
        "pnpm": ">=11",
        "npm": "please-use-pnpm",
        "yarn": "please-use-pnpm"
    },
    "scripts": {
        "start": "cd dist && node server.js",
        "start:local": "dotenv -e .env.prod.local -- pnpm start",
        "assets": "pnpm assets:splash && pnpm assets:icons && pnpm assets:compress",
        "assets:splash": "pnpm assets:splash:dark && pnpm assets:splash:light",
        "assets:splash:light": "pwa-asset-generator public/assets/logo.svg public/assets --padding 'calc(50vh - 20vw) calc(50vw - 20vh)' --type png --background '#eff1f5' --splash-only --path-override /assets --index ./templates/splash.html --xhtml",
        "assets:splash:dark": "pwa-asset-generator public/assets/logo.svg public/assets --padding 'calc(50vh - 20vw) calc(50vw - 20vh)' --type png --background '#1e1e2e' --splash-only --dark-mode --path-override /assets --index ./templates/splash.html --xhtml",
        "assets:icons": "pwa-asset-generator public/assets/logo.svg public/assets --padding '1%' --type png --opaque false --icon-only --favicon --mstile --manifest ./public/manifest.json --path-override /assets --index ./templates/icons.html --xhtml",
        "assets:compress": "oxipng -o 4 public/assets/*.png",
        "build": "pnpm build:client && pnpm build:server",
        "build:client": "NODE_ENV=production vite build --config vite.client.config.ts --mode production",
        "build:server": "vite build --config vite.server.config.ts --mode production",
        "deploy": "pnpm check && pnpm build && pnpm deploy:production",
        "deploy:production": "dotenv -e .env.deploy.local -- vite build --config vite.deploy.config.ts --mode production",
        "dev": "dotenv -e .env.local -- npm-run-all --parallel dev:server dev:client",
        "dev:server": "ts-node --transpile-only --require tsconfig-paths/register src/server/dev.ts",
        "dev:client": "vite",
        "check": "pnpm lint && pnpm test",
        "lint": "pnpm run lint:ts && pnpm run lint:es && pnpm run lint:styles",
        "lint:ts": "tsc --noEmit",
        "lint:es": "eslint src",
        "lint:styles": "stylelint src/**/*.pcss",
        "test": "MONGOMS_VERSION=6.0.14 jest",
        "test:coverage": "jest --coverage",
        "preversion": "git pull && pnpm check",
        "version": "sed -i '' 's/APP_VERSION: \".*\"/APP_VERSION: \"'\"$npm_package_version\"'\"/' ./docker/compose.yaml && git add --all",
        "postversion": "git push && git push --tags",
        "update-deps": "pnpm update --latest && syncpack update && pnpm install"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all",
            "not ie <= 11",
            "iOS >= 10"
        ],
        "development": [
            "last 5 versions"
        ]
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@mantine/core": "^9.4.1",
        "@mantine/dropzone": "^9.4.1",
        "@mantine/form": "^9.4.1",
        "@mantine/hooks": "^9.4.1",
        "@react-oauth/google": "^0.13.5",
        "@reduxjs/toolkit": "^2.12.0",
        "@tabler/icons-react": "^3.45.0",
        "ajv": "^8.20.0",
        "axios": "^1.18.1",
        "blueimp-md5": "^2.19.0",
        "body-parser": "^2.3.0",
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "express-fileupload": "^1.5.2",
        "fast-deep-equal": "^3.1.3",
        "helmet": "^8.3.0",
        "jwt-decode": "^4.0.0",
        "lodash": "^4.18.1",
        "mongodb": "^7.5.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-error-boundary": "^6.1.2",
        "react-redux": "^9.3.0",
        "react-router": "^8.2.0",
        "redux": "^5.0.1",
        "transliteration": "^2.6.1"
    },
    "devDependencies": {
