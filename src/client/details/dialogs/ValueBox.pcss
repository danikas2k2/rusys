.ValueBox {
    header {
        flex-wrap: nowrap;

        .title {
            flex: 1 0 auto;
            padding: 0 1.75rem;
            display: flex;
            flex-flow: column nowrap;
            align-items: center;
            justify-content: center;

            time {
                font-size: var(--font-size-xxxlarge);
                font-weight: var(--font-weight-medium);
            }

            .controls {
                margin-block-start: 0.5rem;
            }
        }

        .close {
            flex: 0;
            width: 0;
            display: flex;
            flex-flow: column nowrap;
            align-items: flex-end;
        }
    }

    article {
        position: relative;
        overflow: auto;
        margin: 0 0.5rem;
        border-radius: var(--radius-medium);
        border: 1px solid var(--color-green);
        background-color: color-mix(in srgb, var(--color-green) 20%, transparent 80%);

        &.recycled {
            border-color: var(--color-red);
            background-color: color-mix(in srgb, var(--color-red) 20%, transparent 80%);
        }
    }

    @media (width <= 320px) {
        article {
            padding-inline: 0;
        }
    }

    @media (width >= 640px) {
        max-width: 100vw;
        max-height: 100vh;

        article {
            columns: 2;
        }
    }

    @media (width >= 768px) {
        article {
            column-gap: 8vw;
        }
    }
}
