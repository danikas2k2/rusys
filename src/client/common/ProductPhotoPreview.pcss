.product-photo-thumbnail {
    flex: 0 0 auto;
    width: 3rem;
    height: 3rem;
    padding: 0;
    overflow: hidden;
    cursor: pointer;
    border: 1px solid var(--mantine-color-default-border);
    border-radius: var(--mantine-radius-md);
    background: var(--mantine-color-default);

    img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
}

.ui-Modal-root[data-photo-preview] {
    .ui-Modal-content {
        display: flex;
        flex: 1;
        flex-direction: column;
        min-height: 0;
        background: var(--mantine-color-body);
    }

    .ui-Modal-header {
        position: absolute;
        z-index: 1;
        inset-block-start: 0;
        inset-inline: 0;
        justify-content: flex-end;
        padding-block: calc(var(--mantine-spacing-sm) + var(--safe-block-start)) var(--mantine-spacing-sm);
        padding-inline: calc(var(--mantine-spacing-sm) + var(--safe-inline-start)) calc(var(--mantine-spacing-sm) + var(--safe-inline-end));
        background: transparent;
    }

    .ui-Modal-title {
        display: none;
    }

    .ui-Modal-close {
        border-radius: 50%;
        background-color: var(--mantine-color-body);
    }

    .ui-Modal-body {
        display: flex;
        flex: 1;
        padding: 0;
        min-height: 0;
    }

    [data-photo-preview-viewport] {
        display: flex;
        flex: 1;
        align-items: center;
        justify-content: center;
        min-width: 0;
        min-height: 0;
        padding: 0;
        overflow: hidden;
        cursor: zoom-in;
        border: 0;
        background: var(--mantine-color-body);
        touch-action: none;

        img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: contain;
            user-select: none;
        }

        &[data-zoomed="true"] {
            cursor: grab;

            &:active {
                cursor: grabbing;
            }

            img {
                width: auto;
                height: auto;
                max-width: none;
                max-height: none;
                object-fit: initial;
            }
        }
    }
}
