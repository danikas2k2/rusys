.ui-Badge-root.change-badge {
    position: absolute;

    &.ui-Badge-root {
        --badge-height: 1.5rem;

        box-shadow: var(--mantine-shadow-sm);
        padding-block: 0.25em;
    }

    .ui-Badge-label {
        position: relative;
        font-size: var(--mantine-font-size-sm);
        font-weight: var(--mantine-font-weight-md);
        line-height: var(--mantine-line-height-md);
        min-height: var(--mantine-line-height-md);
        padding-inline: 0.25em;
        margin-inline: -0.25em;
        width: min-content;
    }

    &[data-position^="top"] {
        inset-block-start: calc(var(--badge-height) / -2);
        margin: auto;
    }

    &[data-position="top"] {
        inset-inline: 0;
    }

    &[data-position="top-left"] {
        inset-inline-end: 100%;
    }

    &[data-position="top-right"] {
        inset-inline-start: 100%;
    }

    &[data-position="left"] {
        inset-inline-end: 125%;
        inset-block-start: 50%;
    }

    &[data-position="right"] {
        inset-inline-start: 125%;
        inset-block-start: 50%;
    }

    &[data-state="updated"] {
        --badge-bg: var(--mantine-color-yellow-filled);
    }

    &[data-state="positive"] {
        --badge-bg: var(--mantine-color-green-filled);
    }

    &[data-state="negative"] {
        --badge-bg: var(--mantine-color-red-filled);
    }
}
