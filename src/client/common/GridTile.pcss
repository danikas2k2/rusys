.ui-Card-root[data-tile] {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    cursor: pointer;
    transition: border-color 150ms ease-in-out;
    background-color: var(--mantine-color-body);

    &[data-hidden="true"] {
        display: none;
    }

    &[data-empty="true"] {
        opacity: 0.55;
    }

    [data-content] {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        grid-template-rows: auto 1fr;
    }

    [data-tile-icon] {
        grid-column: 1;
        grid-row: 1;
        align-self: start;
    }

    [data-tile-heading] {
        grid-column: 2;
        grid-row: 1;
        align-self: start;
    }

    &[data-full-heading="true"] [data-tile-heading] {
        grid-column: 1 / -1;
    }

    [data-tile-amounts] {
        grid-column: 2;
        grid-row: 2;
        align-self: end;
        width: 100%;
        min-width: 0;

        [data-amounts-rows] {
            width: 100%;
            min-width: 0;
        }

        [data-amounts-row] {
            justify-content: flex-end;
        }
    }

    [data-icon-bg] {
        position: absolute;
        inset-inline-start: 4px;
        inset-block-start: 4px;
        width: 76px;
        height: 76px;
        background-size: cover;
        background-position: center;
        filter: blur(3px) opacity(0.5);
        pointer-events: none;
    }

    &[data-photo="true"] {
        [data-photo-bg] {
            position: absolute;
            inset: 0;
            background-size: cover;
            background-position: center;
            filter: blur(3px);
        }

        [data-scrim] {
            position: absolute;
            inset: 0;
            background: var(--mantine-color-crust);
            opacity: 0.25;
        }
    }

    @media (hover: hover) {
        &:hover {
            border-color: var(--mantine-color-primary-filled);
        }
    }
}
