.AboutPage {
    article {
        padding: 0 1rem;
    }

    dl {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 1rem;
        margin: 0;
        padding: 0;

        dt {
            font-weight: bold;
            margin-bottom: 0.5rem;
        }

        dd {
            margin: 0 0 1rem;
        }
    }
}
