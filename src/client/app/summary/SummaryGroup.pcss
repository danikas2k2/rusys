.Row {
    > :first-child {
        grid-column: span 3;
        padding-inline-start: 1rem;
    }
}

.GroupedRows {
    position: relative;
    margin-block-start: 0.125rem;
    margin-inline-end: 0.5rem;
}

.GroupRow {
    font-weight: var(--font-weight-semi-bold);
    padding: 1.25rem 1rem 0.75rem;
    background: var(--color-base)
        linear-gradient(
            135deg,
            color(from var(--color-green) srgb r g b / 0%) 30%,
            color(from var(--color-green) srgb r g b / 50%) 100%
        );
    position: sticky;
    top: 0;
    z-index: 1;

    &.recycled {
        background: var(--color-base)
            linear-gradient(
                135deg,
                color(from var(--color-red) srgb r g b / 0%) 30%,
                color(from var(--color-red) srgb r g b / 50%) 100%
            );
    }
}

.GroupHeading {
    width: 100%;
    font-size: var(--font-size-xxlarge);
}
