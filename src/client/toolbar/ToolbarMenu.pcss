.burger {
    position: absolute;
    top: calc(var(--safe-block-start) + 6px);
    left: calc(var(--safe-inline-start) + 6px);
    z-index: 300;
}

.drawer {
    .ui-Drawer-body {
        padding-inline: var(--safe-inline-start) 0;
        padding-block: 0 var(--safe-block-end);
    }

    .ui-Drawer-content {
        padding: 0;
        flex-basis: min(300px, 60vw);
        height: 100dvh;
        max-height: 100dvh;
    }
}

.menu {
    padding-inline: 0;
    padding-block: calc(4rem + var(--safe-block-start)) var(--safe-block-end);
    height: 100dvh;
}
