.burger {
    position: absolute;
    top: 10px;
    left: 6px;
    z-index: 300;
}

.drawer {
    :global(.mantine-Drawer-body) {
        padding-inline: var(--safe-inline);
        padding-block: 0 var(--safe-block-end);
    }

    :global(.mantine-Drawer-content) {
        padding: 0;
        flex-basis: min(300px, 60vw);

        /* noinspection CssOverwrittenProperties */
        height: 100vh;

        /* noinspection CssOverwrittenProperties */
        height: 100dvh;
        max-height: 100dvh;
    }

    :global(.mantine-Drawer-overlay) {
        opacity: 0.2;
        backdrop-filter: blur(2px);
    }
}

.menu {
    padding-inline: var(--safe-inline);
    padding-block: calc(4rem + var(--safe-block-start)) var(--safe-block-end);

    /* noinspection CssOverwrittenProperties */
    height: 100vh;

    /* noinspection CssOverwrittenProperties */
    height: 100dvh;
}
