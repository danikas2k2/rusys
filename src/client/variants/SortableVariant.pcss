.Name {
    justify-self: stretch;
    font-weight: var(--font-weight-semi-bold);
}

.Row {
    border-block-start: 1px solid var(--color-mantle);
    overflow: hidden;

    &.unused .Name {
        font-weight: var(--font-weight-light);
        text-decoration: underline wavy var(--color-red) 1px;
        text-underline-position: under;
    }
}
