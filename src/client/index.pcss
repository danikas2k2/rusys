:root {
    --toolbar-height: 48px;
    --label-fz: var(--mantine-font-size-md);

    //
    // Safe area insets
    //

    --safe-block-start: 0;
    --safe-block-end: 0;
    --safe-inline-start: 0;
    --safe-inline-end: 0;

    // Safari's browser chrome is not part of safe-area-inset-*. Start from the
    // smallest viewport so content is never obscured, then let visualViewport
    // (set by useVisualViewportHeight) track the visible height precisely.
    --minimum-viewport-height: 100vh;
    --app-viewport-height: var(--visual-viewport-height, var(--minimum-viewport-height));

    @supports (height: 100svh) {
        --minimum-viewport-height: 100svh;
    }

    @supports (top: constant(safe-area-inset-top)) {
        --safe-block-start: constant(safe-area-inset-top);
        --safe-block-end: constant(safe-area-inset-bottom);
        --safe-inline-start: constant(safe-area-inset-left);
        --safe-inline-end: constant(safe-area-inset-right);
    }

    @supports (top: env(safe-area-inset-top)) {
        --safe-block-start: env(safe-area-inset-top, 0px);
        --safe-block-end: env(safe-area-inset-bottom, 0px);
        --safe-inline-start: env(safe-area-inset-left, 0px);
        --safe-inline-end: env(safe-area-inset-right, 0px);
    }
}

html {
    user-select: none;
    height: 100%;
}

html,
body {
    color: var(--mantine-color-text);
    background: var(--mantine-color-body);
    max-width: 100%;
    overflow-x: hidden;
}

body {
    font-family: var(--mantine-font-family), sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    min-height: 100%;
}

code {
    font-family: var(--mantine-font-family-monospace), monospace;
}

// Prevent iOS zoom on input focus
input,
textarea,
select,
.ui-Input-input,
.ui-Select-input,
.ui-NumberInput-input,
.ui-TextInput-input,
.ui-PasswordInput-input,
.ui-Textarea-input,
.ui-Autocomplete-input,
.ui-MultiSelect-input,
.ui-Select-option,
.ui-Button-label,
.ui-InputWrapper-label,
.ui-NavLink-label {
    font-size: var(--mantine-font-size-md);
}

.ui-Burger-root {
    --burger-color: var(--mantine-color-text);
}

.ui-NavLink-label,
.ui-Select-dropdown {
    color: var(--mantine-color-text);
}

.ui-Avatar-placeholder,
.ui-AppShell-header,
.ui-AppShell-footer,
.ui-Drawer-content,
.ui-Drawer-header,
.ui-Drawer-body,
.ui-Input-input,
.ui-Checkbox-input,
.ui-Select-input,
.ui-Select-dropdown,
.ui-Modal-content,
.ui-Modal-header {
    background-color: var(--mantine-color-body);
}

.ui-Select-dropdown {
    border-color: var(--mantine-color-dark-0);
    box-shadow: var(--mantine-shadow-md);
}

// Match the navigation menu hover contrast: the default dark-theme Select hover resolves to a
// surface that is too light for the dropdown text.
@media (hover: hover) {
    .ui-Select-option:hover:not([data-combobox-selected], [data-combobox-disabled]) {
        background-color: light-dark(var(--mantine-color-default-hover), var(--mantine-color-mantle));
    }
}

.ui-Input-input,
.ui-Checkbox-input,
.ui-Select-input {
    &:disabled {
        //--mantine-color-disabled: var(--mantine-color-surface0);
    }
}

@media (hover: none) {
    .ui-NavLink-root,
    .ui-Select-option {
        &:active {
            background-color: var(--mantine-primary-color-light);
        }
    }
}

.ui-SegmentedControl-root {
    background-color: var(--mantine-color-neutral-3);
    border-color: var(--mantine-color-default-border);

    .ui-SegmentedControl-label:not([data-active="true"]) {
        color: inherit;
    }
}

.ui-Modal-overlay,
.ui-Drawer-overlay {
    opacity: 0.2;
    backdrop-filter: blur(2px);
}

// Keep modals sized to the space actually left on screen once the mobile keyboard opens.
// window.visualViewport (see useVisualViewportHeight) tracks this more reliably across
// browsers than the dvh unit, which some mobile browsers don't shrink for the keyboard.
.ui-Modal-root {
    --modal-content-max-height: calc(var(--app-viewport-height) - var(--modal-y-offset) * 2);

    .ui-Modal-close {
        color: var(--mantine-color-text);
    }
}

.ui-Modal-header {
    z-index: -1;
}

.ui-Modal-title {
    font-size: var(--mantine-font-size-xl);
    font-weight: var(--mantine-font-weight-lg);
}

.ui-Modal-root[data-full-screen="true"] {
    .ui-Modal-header {
        padding-block-start: calc(var(--mb-padding, var(--mantine-spacing-md)) + var(--safe-block-start));
        padding-inline: calc(var(--mb-padding, var(--mantine-spacing-md)) + var(--safe-inline-start)) calc(var(--mb-padding, var(--mantine-spacing-md)) - calc(0.3125rem * var(--mantine-scale)) + var(--safe-inline-end));
    }

    .ui-Modal-body {
        padding-block-end: calc(var(--mb-padding, var(--mantine-spacing-md)) + var(--safe-block-end));
        padding-inline: calc(var(--mb-padding, var(--mantine-spacing-md)) + var(--safe-inline-start)) calc(var(--mb-padding, var(--mantine-spacing-md)) + var(--safe-inline-end));
    }

    .ui-Modal-content {
        --modal-content-max-height: none;
        --modal-content-height: var(--app-viewport-height);
    }
}

// Above this width AND height, a fullscreen dialog (AmountBox, ReviewBox, SummaryHistoryBox) no
// longer needs to cover the whole viewport - windowing it avoids wasting space around a
// comparatively small form/table on a wide desktop screen. Both conditions must hold, not just
// width: phone landscape has the width but not the height, and stays fullscreen there instead,
// reflowing its own content internally rather than trying to fit a shrunken dialog chrome too.
@media (width >= 48em) and (height >= 37.5em) {
    .ui-Modal-root[data-full-screen="true"] {
        --windowed-modal-top: clamp(3rem, 10svh, 7rem);

        .ui-Modal-content {
            --modal-content-flex: 0 0 min(48rem, 90vw);
            --modal-content-height: auto;
            --modal-content-max-height: calc(var(--app-viewport-height) - var(--windowed-modal-top) - 5svh);

            border-radius: var(--mantine-radius-default);
        }

        .ui-Modal-header {
            border-start-start-radius: var(--mantine-radius-default);
            border-start-end-radius: var(--mantine-radius-default);
        }

        .ui-Modal-inner {
            --modal-inner-y-offset: var(--windowed-modal-top);
            --modal-inner-x-offset: 5vw;

            align-items: flex-start;
        }
    }
}

.ui-Modal-root[data-type="confirm"] {
    .ui-Modal-header {
        align-items: flex-start;
    }

    .ui-Modal-title {
        padding-block: 2rem 1rem;
    }

    .ui-Modal-body {
        padding-block-end: 2.5rem;
    }

    .ui-Button-root[data-variant="outline"] {
        background-color: var(--mantine-color-neutral-2)
    }
}

.ui-Dropzone-root {
    &:where([data-idle]) {
        color: var(--mantine-color-text);
        background-color: color-mix(in srgb, transparent, var(--mantine-color-neutral-3));
        border-color: var(--mantine-color-default-border);
    }

    @media (hover: hover) {
        &:hover:where([data-idle][data-activate-on-click]:not([data-loading])) {
            background-color: light-dark(var(--mantine-color-default-hover), var(--mantine-color-mantle));
        }
    }

    &:where([data-accept]) {
        --mantine-color-dimmed: color-mix(in srgb, var(--mantine-color-positive-text) 30%, var(--mantine-color-subtext0) 70%);

        color: var(--mantine-color-positive-text);
        background-color: color-mix(in srgb, transparent, var(--mantine-color-positive-filled) 20%);
        border-color: color-mix(in srgb, var(--mantine-color-positive-filled) 20%, var(--mantine-color-surface2) 80%);
    }

    &:where([data-reject]) {
        --mantine-color-dimmed: color-mix(in srgb, var(--mantine-color-negative-text) 30%, var(--mantine-color-subtext0) 70%);

        color: var(--mantine-color-negative-text);
        background-color: color-mix(in srgb, transparent, var(--mantine-color-negative-filled) 20%);
        border-color: color-mix(in srgb, var(--mantine-color-negative-filled) 20%, var(--mantine-color-surface2) 80%);
    }
}

.ui-Table-table {
    --table-border-color: var(--mantine-color-neutral-1);

    font-size: var(--mantine-font-size-md);
    margin-block-end: 1rem;

    &[data-drag-overlay='true'] {
        table-layout: fixed;
        width: 100%;
        background-color: var(--mantine-color-body);
        box-shadow: var(--mantine-shadow-md);
    }
}

.ui-Table-th {
    font-weight: var(--mantine-font-weight-sm);
}

.ui-Table-thead {
    position: sticky;
    inset-block-start: 0;
    background-color: var(--mantine-color-body);
}

.ui-Table-thead,
.ui-Table-tbody,
.ui-Table-tr {
    --transition-duration: 100ms;
    --transition-timing-function: linear;

    transition: height var(--transition-duration) var(--transition-timing-function),
    padding var(--transition-duration) var(--transition-timing-function),
    margin var(--transition-duration) var(--transition-timing-function),
    opacity var(--transition-duration) var(--transition-timing-function) calc(var(--transition-duration) / 2),
    visibility 0s var(--transition-timing-function);

    &[data-hidden="true"] {
        visibility: collapse;
        opacity: 0;
        height: 0;
        padding: 0;
        margin: 0;
        border: 0;
        transition: height var(--transition-duration) var(--transition-timing-function),
        padding var(--transition-duration) var(--transition-timing-function),
        margin var(--transition-duration) var(--transition-timing-function),
        opacity var(--transition-duration) var(--transition-timing-function),
        visibility 0s var(--transition-timing-function) var(--transition-duration);
    }
}

// iOS Safari does not reliably collapse table sections/rows with height:0 + visibility:collapse.
// Use display:none as a fallback so filtered-out rows don't keep their layout height.
@supports (-webkit-touch-callout: none) {
    .ui-Table-thead[data-hidden='true'],
    .ui-Table-tbody[data-hidden='true'],
    .ui-Table-tr[data-hidden='true'] {
        display: none !important;
    }
}

.ui-Table-tr[data-dragging='true'] {
    position: relative;
    z-index: 1;

    &, .ui-Table-th, .ui-Table-td {
        box-shadow: var(--mantine-shadow-sm);
        background-color: var(--mantine-color-body);
    }
}

.ui-Title-root {
    &[data-available="false"] {
        color: var(--mantine-color-dark-text);
        font-weight: var(--mantine-font-weight-xs);
    }

    &[data-available="true"][data-removing="true"] {
        color: var(--mantine-color-negative-text);
        font-weight: var(--mantine-font-weight-xl);
        letter-spacing: -0.25px;
        text-decoration: underline dashed 1px;
        text-underline-position: under;
    }

    &[data-unused="true"] {
        font-weight: var(--mantine-font-weight-xs);
        color: var(--mantine-color-dark-text);
        text-decoration: underline wavy 1px;
        text-decoration-color: var(--mantine-color-negative-text);
        text-underline-position: under;
    }
}

.ui-Alert-message {
    color: var(--alert-color);
}

.ui-Tabs-tab[data-active="true"] {
    background-color: var(--mantine-color-base);
}

.ui-Tabs-list[data-orientation="vertical"] {
    .ui-Tabs-tab:not([data-active="true"]) {
        border-top: 0;
        border-bottom: 0;
    }
}

time[data-date], time[data-time] {
    text-wrap: nowrap;
}

time[data-date]:has(+ time[data-time])::after {
    content: ", ";
    text-wrap: wrap;
}
