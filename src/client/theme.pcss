@import url("https://fonts.googleapis.com/css2?family=Noto+Color+Emoji&family=Noto+Sans+Display:ital,wdth,wght@0,62.5..100,100..900;1,62.5..100,100..900&family=Noto+Sans+Mono:wdth,wght@62.5..100,100..900&family=Noto+Sans:ital,wdth,wght@0,62.5..100,100..900;1,62.5..100,100..900&display=swap");
@import "@catppuccin/palette/css/catppuccin.css";

:root {
    // Font family variables
    --mantine-font-family-fallback: -apple-system, "BlinkMacSystemFont", "Segoe UI", "Roboto", "Helvetica", "Arial", sans-serif, "Apple Color Emoji", "Segoe UI Emoji";
    --mantine-font-family: "NotoSans Nerd Font", "Noto Sans", "Noto Color Emoji", var(--mantine-font-family-fallback);
    --mantine-font-family-headings: "Noto Sans Display", var(--mantine-font-family-fallback);
    --mantine-font-family-monospace-fallback: ui-monospace, "SFMono-Regular", "Menlo", "Monaco", "Consolas", "Liberation Mono", "Courier New", monospace;
    --mantine-font-family-monospace: "NotoSansM Nerd Font", "Noto Sans Mono", "Source Code Pro", var(--mantine-font-family-monospace-fallback);

    // Font weights
    --mantine-font-weight-xs: 300;
    --mantine-font-weight-sm: 400; // normal
    --mantine-font-weight-md: 500;
    --mantine-font-weight-lg: 600;
    --mantine-font-weight-xl: 700; // bold

    //
    // Other mantine values
    //

    --mantine-radius-default: var(--mantine-radius-md);

    //
    // Focus variables
    // TODO: not sure if still needed
    //

    //--focus-thickness: 2px;
    //--focus-outline-offset: var(--focus-thickness, 2px);
    //--focus-color: var(--mantine-color-blue);
    //--focus-outline: var(--focus-thickness, 2px) solid var(--focus-color);

    // Shadow variables
    --mantine-shadow-xs: 0 calc(0.125rem * var(--mantine-scale)) calc(0.25rem * var(--mantine-scale)) calc(-0.0625rem * var(--mantine-scale)) var(--mantine-color-shadow), 0 calc(0.125rem * var(--mantine-scale)) calc(0.25rem * var(--mantine-scale)) calc(-0.125rem * var(--mantine-scale)) var(--mantine-color-shadow);
    --mantine-shadow-sm: 0 calc(0.125rem * var(--mantine-scale)) calc(0.25rem * var(--mantine-scale)) calc(-0.125rem * var(--mantine-scale)) var(--mantine-color-shadow), 0 calc(0.25rem * var(--mantine-scale)) calc(0.5rem * var(--mantine-scale)) calc(-0.125rem * var(--mantine-scale)) var(--mantine-color-shadow);
    --mantine-shadow-md: 0 calc(0.125rem * var(--mantine-scale)) calc(0.5rem * var(--mantine-scale)) calc(-0.125rem * var(--mantine-scale)) var(--mantine-color-shadow), 0 calc(0.375rem * var(--mantine-scale)) calc(0.75rem * var(--mantine-scale)) calc(-0.125rem * var(--mantine-scale)) var(--mantine-color-shadow);
    --mantine-shadow-lg: 0 calc(0.125rem * var(--mantine-scale)) calc(0.5rem * var(--mantine-scale)) calc(-0.125rem * var(--mantine-scale)) var(--mantine-color-shadow), 0 calc(0.750rem * var(--mantine-scale)) calc(1rem * var(--mantine-scale)) calc(-0.25rem * var(--mantine-scale)) var(--mantine-color-shadow);
    --mantine-shadow-xl: 0 calc(0.125rem * var(--mantine-scale)) calc(0.5rem * var(--mantine-scale)) calc(-0.125rem * var(--mantine-scale)) var(--mantine-color-shadow), 0 calc(1.125rem * var(--mantine-scale)) calc(1.5rem * var(--mantine-scale)) calc(-0.25rem * var(--mantine-scale)) var(--mantine-color-shadow);

    // Color scheme variables
    color-scheme: var(--mantine-color-scheme, auto);

    &[data-mantine-color-scheme="light"] {
        --mantine-color-scheme: light;
    }

    &[data-mantine-color-scheme="dark"] {
        --mantine-color-scheme: dark;
    }

    &:not([data-mantine-color-scheme]) {
        @media (prefers-color-scheme: light) {
            --mantine-color-scheme: light;
        }

        @media (prefers-color-scheme: dark) {
            --mantine-color-scheme: dark;
        }
    }

    &[data-mantine-color-scheme] {
        // Shade curves (0 lightest -> 9 darkest)
        // latte (s)
        --ctp-latte-s-0: 0.50;
        --ctp-latte-s-1: 0.55;
        --ctp-latte-s-2: 0.60;
        --ctp-latte-s-3: 0.70;
        --ctp-latte-s-4: 0.85;
        --ctp-latte-s-5: 0.95;
        --ctp-latte-s-6: 1.00;
        --ctp-latte-s-7: 1.05;
        --ctp-latte-s-8: 1.10;
        --ctp-latte-s-9: 1.15;
        // latte (l)
        --ctp-latte-l-0: 1.30;
        --ctp-latte-l-1: 1.22;
        --ctp-latte-l-2: 1.16;
        --ctp-latte-l-3: 1.10;
        --ctp-latte-l-4: 1.05;
        --ctp-latte-l-5: 1.02;
        --ctp-latte-l-6: 1.00;
        --ctp-latte-l-7: 0.94;
        --ctp-latte-l-8: 0.88;
        --ctp-latte-l-9: 0.82;
        // mocha (s)
        --ctp-mocha-s-0: 0.59;
        --ctp-mocha-s-1: 0.64;
        --ctp-mocha-s-2: 0.73;
        --ctp-mocha-s-3: 0.82;
        --ctp-mocha-s-4: 0.91;
        --ctp-mocha-s-5: 0.95;
        --ctp-mocha-s-6: 1.00;
        --ctp-mocha-s-7: 1.05;
        --ctp-mocha-s-8: 1.09;
        --ctp-mocha-s-9: 1.14;
        // mocha (l)
        --ctp-mocha-l-0: 0.70;
        --ctp-mocha-l-1: 0.78;
        --ctp-mocha-l-2: 0.86;
        --ctp-mocha-l-3: 0.92;
        --ctp-mocha-l-4: 0.97;
        --ctp-mocha-l-5: 0.99;
        --ctp-mocha-l-6: 1.00;
        --ctp-mocha-l-7: 1.04;
        --ctp-mocha-l-8: 1.12;
        --ctp-mocha-l-9: 1.20;

        // Mixed base colors that depend on both palettes

        // rosewater
        --ctp-latte-rosewater-0: hsl(from var(--ctp-latte-rosewater) h calc(s * var(--ctp-latte-s-0)) clamp(0, calc(l * var(--ctp-latte-l-0)), 100));
        --ctp-latte-rosewater-1: hsl(from var(--ctp-latte-rosewater) h calc(s * var(--ctp-latte-s-1)) clamp(0, calc(l * var(--ctp-latte-l-1)), 100));
        --ctp-latte-rosewater-2: hsl(from var(--ctp-latte-rosewater) h calc(s * var(--ctp-latte-s-2)) clamp(0, calc(l * var(--ctp-latte-l-2)), 100));
        --ctp-latte-rosewater-3: hsl(from var(--ctp-latte-rosewater) h calc(s * var(--ctp-latte-s-3)) clamp(0, calc(l * var(--ctp-latte-l-3)), 100));
        --ctp-latte-rosewater-4: hsl(from var(--ctp-latte-rosewater) h calc(s * var(--ctp-latte-s-4)) clamp(0, calc(l * var(--ctp-latte-l-4)), 100));
        --ctp-latte-rosewater-5: hsl(from var(--ctp-latte-rosewater) h calc(s * var(--ctp-latte-s-5)) clamp(0, calc(l * var(--ctp-latte-l-5)), 100));
        --ctp-latte-rosewater-6: hsl(from var(--ctp-latte-rosewater) h calc(s * var(--ctp-latte-s-6)) clamp(0, calc(l * var(--ctp-latte-l-6)), 100));
        --ctp-latte-rosewater-7: hsl(from var(--ctp-latte-rosewater) h calc(s * var(--ctp-latte-s-7)) clamp(0, calc(l * var(--ctp-latte-l-7)), 100));
        --ctp-latte-rosewater-8: hsl(from var(--ctp-latte-rosewater) h calc(s * var(--ctp-latte-s-8)) clamp(0, calc(l * var(--ctp-latte-l-8)), 100));
        --ctp-latte-rosewater-9: hsl(from var(--ctp-latte-rosewater) h calc(s * var(--ctp-latte-s-9)) clamp(0, calc(l * var(--ctp-latte-l-9)), 100));
        --ctp-mocha-rosewater-0: hsl(from var(--ctp-mocha-rosewater) h calc(s * var(--ctp-mocha-s-0)) clamp(0, calc(l * var(--ctp-mocha-l-0)), 100));
        --ctp-mocha-rosewater-1: hsl(from var(--ctp-mocha-rosewater) h calc(s * var(--ctp-mocha-s-1)) clamp(0, calc(l * var(--ctp-mocha-l-1)), 100));
        --ctp-mocha-rosewater-2: hsl(from var(--ctp-mocha-rosewater) h calc(s * var(--ctp-mocha-s-2)) clamp(0, calc(l * var(--ctp-mocha-l-2)), 100));
        --ctp-mocha-rosewater-3: hsl(from var(--ctp-mocha-rosewater) h calc(s * var(--ctp-mocha-s-3)) clamp(0, calc(l * var(--ctp-mocha-l-3)), 100));
        --ctp-mocha-rosewater-4: hsl(from var(--ctp-mocha-rosewater) h calc(s * var(--ctp-mocha-s-4)) clamp(0, calc(l * var(--ctp-mocha-l-4)), 100));
        --ctp-mocha-rosewater-5: hsl(from var(--ctp-mocha-rosewater) h calc(s * var(--ctp-mocha-s-5)) clamp(0, calc(l * var(--ctp-mocha-l-5)), 100));
        --ctp-mocha-rosewater-6: hsl(from var(--ctp-mocha-rosewater) h calc(s * var(--ctp-mocha-s-6)) clamp(0, calc(l * var(--ctp-mocha-l-6)), 100));
        --ctp-mocha-rosewater-7: hsl(from var(--ctp-mocha-rosewater) h calc(s * var(--ctp-mocha-s-7)) clamp(0, calc(l * var(--ctp-mocha-l-7)), 100));
        --ctp-mocha-rosewater-8: hsl(from var(--ctp-mocha-rosewater) h calc(s * var(--ctp-mocha-s-8)) clamp(0, calc(l * var(--ctp-mocha-l-8)), 100));
        --ctp-mocha-rosewater-9: hsl(from var(--ctp-mocha-rosewater) h calc(s * var(--ctp-mocha-s-9)) clamp(0, calc(l * var(--ctp-mocha-l-9)), 100));
        --mantine-color-rosewater-0: light-dark(var(--ctp-latte-rosewater-0), var(--ctp-mocha-rosewater-0));
        --mantine-color-rosewater-1: light-dark(var(--ctp-latte-rosewater-1), var(--ctp-mocha-rosewater-1));
        --mantine-color-rosewater-2: light-dark(var(--ctp-latte-rosewater-2), var(--ctp-mocha-rosewater-2));
        --mantine-color-rosewater-3: light-dark(var(--ctp-latte-rosewater-3), var(--ctp-mocha-rosewater-3));
        --mantine-color-rosewater-4: light-dark(var(--ctp-latte-rosewater-4), var(--ctp-mocha-rosewater-4));
        --mantine-color-rosewater-5: light-dark(var(--ctp-latte-rosewater-5), var(--ctp-mocha-rosewater-5));
        --mantine-color-rosewater-6: light-dark(var(--ctp-latte-rosewater-6), var(--ctp-mocha-rosewater-6));
        --mantine-color-rosewater-7: light-dark(var(--ctp-latte-rosewater-7), var(--ctp-mocha-rosewater-7));
        --mantine-color-rosewater-8: light-dark(var(--ctp-latte-rosewater-8), var(--ctp-mocha-rosewater-8));
        --mantine-color-rosewater-9: light-dark(var(--ctp-latte-rosewater-9), var(--ctp-mocha-rosewater-9));
        --mantine-color-rosewater-text: var(--mantine-color-rosewater-filled);
        --mantine-color-rosewater-filled: var(--mantine-color-rosewater-6);
        --mantine-color-rosewater-filled-hover: var(--mantine-color-rosewater-7);
        --mantine-color-rosewater-light: color(from var(--mantine-color-rosewater-6) srgb r g b / 10%);
        --mantine-color-rosewater-light-hover: color(from var(--mantine-color-rosewater-6) srgb r g b / 12%);
        --mantine-color-rosewater-light-color: var(--mantine-color-rosewater-6);
        --mantine-color-rosewater-outline: var(--mantine-color-rosewater-6);
        --mantine-color-rosewater-outline-hover: color(from var(--mantine-color-rosewater-6) srgb r g b / 5%);

        // flamingo
        --ctp-latte-flamingo-0: hsl(from var(--ctp-latte-flamingo) h calc(s * var(--ctp-latte-s-0)) clamp(0, calc(l * var(--ctp-latte-l-0)), 100));
        --ctp-latte-flamingo-1: hsl(from var(--ctp-latte-flamingo) h calc(s * var(--ctp-latte-s-1)) clamp(0, calc(l * var(--ctp-latte-l-1)), 100));
        --ctp-latte-flamingo-2: hsl(from var(--ctp-latte-flamingo) h calc(s * var(--ctp-latte-s-2)) clamp(0, calc(l * var(--ctp-latte-l-2)), 100));
        --ctp-latte-flamingo-3: hsl(from var(--ctp-latte-flamingo) h calc(s * var(--ctp-latte-s-3)) clamp(0, calc(l * var(--ctp-latte-l-3)), 100));
        --ctp-latte-flamingo-4: hsl(from var(--ctp-latte-flamingo) h calc(s * var(--ctp-latte-s-4)) clamp(0, calc(l * var(--ctp-latte-l-4)), 100));
        --ctp-latte-flamingo-5: hsl(from var(--ctp-latte-flamingo) h calc(s * var(--ctp-latte-s-5)) clamp(0, calc(l * var(--ctp-latte-l-5)), 100));
        --ctp-latte-flamingo-6: hsl(from var(--ctp-latte-flamingo) h calc(s * var(--ctp-latte-s-6)) clamp(0, calc(l * var(--ctp-latte-l-6)), 100));
        --ctp-latte-flamingo-7: hsl(from var(--ctp-latte-flamingo) h calc(s * var(--ctp-latte-s-7)) clamp(0, calc(l * var(--ctp-latte-l-7)), 100));
        --ctp-latte-flamingo-8: hsl(from var(--ctp-latte-flamingo) h calc(s * var(--ctp-latte-s-8)) clamp(0, calc(l * var(--ctp-latte-l-8)), 100));
        --ctp-latte-flamingo-9: hsl(from var(--ctp-latte-flamingo) h calc(s * var(--ctp-latte-s-9)) clamp(0, calc(l * var(--ctp-latte-l-9)), 100));
        --ctp-mocha-flamingo-0: hsl(from var(--ctp-mocha-flamingo) h calc(s * var(--ctp-mocha-s-0)) clamp(0, calc(l * var(--ctp-mocha-l-0)), 100));
        --ctp-mocha-flamingo-1: hsl(from var(--ctp-mocha-flamingo) h calc(s * var(--ctp-mocha-s-1)) clamp(0, calc(l * var(--ctp-mocha-l-1)), 100));
        --ctp-mocha-flamingo-2: hsl(from var(--ctp-mocha-flamingo) h calc(s * var(--ctp-mocha-s-2)) clamp(0, calc(l * var(--ctp-mocha-l-2)), 100));
        --ctp-mocha-flamingo-3: hsl(from var(--ctp-mocha-flamingo) h calc(s * var(--ctp-mocha-s-3)) clamp(0, calc(l * var(--ctp-mocha-l-3)), 100));
        --ctp-mocha-flamingo-4: hsl(from var(--ctp-mocha-flamingo) h calc(s * var(--ctp-mocha-s-4)) clamp(0, calc(l * var(--ctp-mocha-l-4)), 100));
        --ctp-mocha-flamingo-5: hsl(from var(--ctp-mocha-flamingo) h calc(s * var(--ctp-mocha-s-5)) clamp(0, calc(l * var(--ctp-mocha-l-5)), 100));
        --ctp-mocha-flamingo-6: hsl(from var(--ctp-mocha-flamingo) h calc(s * var(--ctp-mocha-s-6)) clamp(0, calc(l * var(--ctp-mocha-l-6)), 100));
        --ctp-mocha-flamingo-7: hsl(from var(--ctp-mocha-flamingo) h calc(s * var(--ctp-mocha-s-7)) clamp(0, calc(l * var(--ctp-mocha-l-7)), 100));
        --ctp-mocha-flamingo-8: hsl(from var(--ctp-mocha-flamingo) h calc(s * var(--ctp-mocha-s-8)) clamp(0, calc(l * var(--ctp-mocha-l-8)), 100));
        --ctp-mocha-flamingo-9: hsl(from var(--ctp-mocha-flamingo) h calc(s * var(--ctp-mocha-s-9)) clamp(0, calc(l * var(--ctp-mocha-l-9)), 100));
        --mantine-color-flamingo-0: light-dark(var(--ctp-latte-flamingo-0), var(--ctp-mocha-flamingo-0));
        --mantine-color-flamingo-1: light-dark(var(--ctp-latte-flamingo-1), var(--ctp-mocha-flamingo-1));
        --mantine-color-flamingo-2: light-dark(var(--ctp-latte-flamingo-2), var(--ctp-mocha-flamingo-2));
        --mantine-color-flamingo-3: light-dark(var(--ctp-latte-flamingo-3), var(--ctp-mocha-flamingo-3));
        --mantine-color-flamingo-4: light-dark(var(--ctp-latte-flamingo-4), var(--ctp-mocha-flamingo-4));
        --mantine-color-flamingo-5: light-dark(var(--ctp-latte-flamingo-5), var(--ctp-mocha-flamingo-5));
        --mantine-color-flamingo-6: light-dark(var(--ctp-latte-flamingo-6), var(--ctp-mocha-flamingo-6));
        --mantine-color-flamingo-7: light-dark(var(--ctp-latte-flamingo-7), var(--ctp-mocha-flamingo-7));
        --mantine-color-flamingo-8: light-dark(var(--ctp-latte-flamingo-8), var(--ctp-mocha-flamingo-8));
        --mantine-color-flamingo-9: light-dark(var(--ctp-latte-flamingo-9), var(--ctp-mocha-flamingo-9));
        --mantine-color-flamingo-text: var(--mantine-color-flamingo-filled);
        --mantine-color-flamingo-filled: var(--mantine-color-flamingo-6);
        --mantine-color-flamingo-filled-hover: var(--mantine-color-flamingo-7);
        --mantine-color-flamingo-light: color(from var(--mantine-color-flamingo-6) srgb r g b / 10%);
        --mantine-color-flamingo-light-hover: color(from var(--mantine-color-flamingo-6) srgb r g b / 12%);
        --mantine-color-flamingo-light-color: var(--mantine-color-flamingo-6);
        --mantine-color-flamingo-outline: var(--mantine-color-flamingo-6);
        --mantine-color-flamingo-outline-hover: color(from var(--mantine-color-flamingo-6) srgb r g b / 5%);

        // pink
        --ctp-latte-pink-0: hsl(from var(--ctp-latte-pink) h calc(s * var(--ctp-latte-s-0)) clamp(0, calc(l * var(--ctp-latte-l-0)), 100));
        --ctp-latte-pink-1: hsl(from var(--ctp-latte-pink) h calc(s * var(--ctp-latte-s-1)) clamp(0, calc(l * var(--ctp-latte-l-1)), 100));
        --ctp-latte-pink-2: hsl(from var(--ctp-latte-pink) h calc(s * var(--ctp-latte-s-2)) clamp(0, calc(l * var(--ctp-latte-l-2)), 100));
        --ctp-latte-pink-3: hsl(from var(--ctp-latte-pink) h calc(s * var(--ctp-latte-s-3)) clamp(0, calc(l * var(--ctp-latte-l-3)), 100));
        --ctp-latte-pink-4: hsl(from var(--ctp-latte-pink) h calc(s * var(--ctp-latte-s-4)) clamp(0, calc(l * var(--ctp-latte-l-4)), 100));
        --ctp-latte-pink-5: hsl(from var(--ctp-latte-pink) h calc(s * var(--ctp-latte-s-5)) clamp(0, calc(l * var(--ctp-latte-l-5)), 100));
        --ctp-latte-pink-6: hsl(from var(--ctp-latte-pink) h calc(s * var(--ctp-latte-s-6)) clamp(0, calc(l * var(--ctp-latte-l-6)), 100));
        --ctp-latte-pink-7: hsl(from var(--ctp-latte-pink) h calc(s * var(--ctp-latte-s-7)) clamp(0, calc(l * var(--ctp-latte-l-7)), 100));
        --ctp-latte-pink-8: hsl(from var(--ctp-latte-pink) h calc(s * var(--ctp-latte-s-8)) clamp(0, calc(l * var(--ctp-latte-l-8)), 100));
        --ctp-latte-pink-9: hsl(from var(--ctp-latte-pink) h calc(s * var(--ctp-latte-s-9)) clamp(0, calc(l * var(--ctp-latte-l-9)), 100));
        --ctp-mocha-pink-0: hsl(from var(--ctp-mocha-pink) h calc(s * var(--ctp-mocha-s-0)) clamp(0, calc(l * var(--ctp-mocha-l-0)), 100));
        --ctp-mocha-pink-1: hsl(from var(--ctp-mocha-pink) h calc(s * var(--ctp-mocha-s-1)) clamp(0, calc(l * var(--ctp-mocha-l-1)), 100));
        --ctp-mocha-pink-2: hsl(from var(--ctp-mocha-pink) h calc(s * var(--ctp-mocha-s-2)) clamp(0, calc(l * var(--ctp-mocha-l-2)), 100));
        --ctp-mocha-pink-3: hsl(from var(--ctp-mocha-pink) h calc(s * var(--ctp-mocha-s-3)) clamp(0, calc(l * var(--ctp-mocha-l-3)), 100));
        --ctp-mocha-pink-4: hsl(from var(--ctp-mocha-pink) h calc(s * var(--ctp-mocha-s-4)) clamp(0, calc(l * var(--ctp-mocha-l-4)), 100));
        --ctp-mocha-pink-5: hsl(from var(--ctp-mocha-pink) h calc(s * var(--ctp-mocha-s-5)) clamp(0, calc(l * var(--ctp-mocha-l-5)), 100));
        --ctp-mocha-pink-6: hsl(from var(--ctp-mocha-pink) h calc(s * var(--ctp-mocha-s-6)) clamp(0, calc(l * var(--ctp-mocha-l-6)), 100));
        --ctp-mocha-pink-7: hsl(from var(--ctp-mocha-pink) h calc(s * var(--ctp-mocha-s-7)) clamp(0, calc(l * var(--ctp-mocha-l-7)), 100));
        --ctp-mocha-pink-8: hsl(from var(--ctp-mocha-pink) h calc(s * var(--ctp-mocha-s-8)) clamp(0, calc(l * var(--ctp-mocha-l-8)), 100));
        --ctp-mocha-pink-9: hsl(from var(--ctp-mocha-pink) h calc(s * var(--ctp-mocha-s-9)) clamp(0, calc(l * var(--ctp-mocha-l-9)), 100));
