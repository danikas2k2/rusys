        --mantine-color-gray-filled: var(--mantine-color-gray-6);
        --mantine-color-gray-filled-hover: var(--mantine-color-gray-7);
        --mantine-color-gray-light: color(from var(--mantine-color-gray-6) srgb r g b / 10%);
        --mantine-color-gray-light-hover: color(from var(--mantine-color-gray-6) srgb r g b / 12%);
        --mantine-color-gray-light-color: var(--mantine-color-gray-6);
        --mantine-color-gray-outline: var(--mantine-color-gray-6);
        --mantine-color-gray-outline-hover: color(from var(--mantine-color-gray-6) srgb r g b / 5%);

        // dark
        --mantine-color-dark-0: var(--mantine-color-surface0);
        --mantine-color-dark-1: var(--mantine-color-surface1);
        --mantine-color-dark-2: var(--mantine-color-surface2);
        --mantine-color-dark-3: var(--mantine-color-overlay0);
        --mantine-color-dark-4: var(--mantine-color-overlay1);
        --mantine-color-dark-5: var(--mantine-color-overlay2);
        --mantine-color-dark-6: var(--mantine-color-subtext0);
        --mantine-color-dark-7: var(--mantine-color-subtext1);
        --mantine-color-dark-8: var(--mantine-color-text);
        --mantine-color-dark-9: var(--mantine-color-strong);
        --mantine-color-dark-text: var(--mantine-color-dark-filled);
        --mantine-color-dark-filled: var(--mantine-color-dark-6);
        --mantine-color-dark-filled-hover: var(--mantine-color-dark-7);
        --mantine-color-dark-light: color(from var(--mantine-color-dark-6) srgb r g b / 10%);
        --mantine-color-dark-light-hover: color(from var(--mantine-color-dark-6) srgb r g b / 12%);
        --mantine-color-dark-light-color: var(--mantine-color-dark-6);
        --mantine-color-dark-outline: var(--mantine-color-dark-6);
        --mantine-color-dark-outline-hover: color(from var(--mantine-color-dark-6) srgb r g b / 5%);
    }
}
