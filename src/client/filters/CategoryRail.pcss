:root {
    --category-rail-width: 12rem;

    @media (width >= 54em) {
        --category-rail-width: 14rem;
    }
}

.ui-Tabs-root[data-tabs='category-rail'] {
    --tab-border-color: var(--mantine-color-default-border);

    position: sticky;
    top: 0;
    max-height: var(--app-viewport-height);
    overflow: hidden auto;
    box-sizing: border-box;

    @media (width >= 48em) {
        width: var(--category-rail-width);
        min-width: var(--category-rail-width);
        max-width: var(--category-rail-width);
        flex: 0 0 var(--category-rail-width);

        .ui-Tabs-tab {
            width: 100%;
            min-width: 0;
        }
    }

    .ui-Tabs-list {
        width: 100%;
        min-width: 0;

        &::before,
        &::after {
            content: '';
            display: block;
            position: sticky;
            inset-inline: 0;
            pointer-events: none;
            z-index: 2;
        }

        &::before {
            top: 0;
            height: 1.5rem;
            background: linear-gradient(to top, var(--mantine-color-mantle), transparent);
        }

        &::after {
            bottom: 0;
            height: 2.5rem;
            background: linear-gradient(to bottom, var(--mantine-color-mantle), transparent);
            border-inline-end: 1px solid var(--tab-border-color);
        }
    }

    .ui-Avatar-root[data-grayed="true"] {
        filter: grayscale(1);
        opacity: 0.4;
    }

    .ui-Tabs-tab {
        min-width: 0;
        overflow: hidden;
        box-sizing: border-box;
        text-align: start;

        .ui-Tabs-tabLabel {
            display: block;
            width: 100%;
            min-width: 0;
            overflow: hidden;
            text-align: start;
        }

        .ui-Avatar-root {
            flex: 0 0 auto;
        }

        [data-category-label] {
            flex: 1 1 auto;
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        &:not([data-active="true"]) {
            background-color: var(--mantine-color-mantle);
            border-inline-end: 1px solid var(--tab-border-color);
        }

        &[data-active="true"] .ui-Avatar-root {
            transform: scale(1.35);
            margin-inline: 3px -3px;
        }

        &[data-active="true"] {
            overflow: visible;

            .ui-Tabs-tabLabel {
                overflow: visible;
            }
        }
    }
}
