.CategoryRailLayout-content {
    flex: 1;
    min-width: 0;

    [data-category-heading] {
        margin: var(--mantine-spacing-xs);
        font-size: var(--mantine-font-size-xl);
        line-height: 1.25;
    }

    // Past Mantine's `lg` breakpoint (desktop), an unconstrained table/grid stretches across the
    // whole remaining width with large empty gutters between sparse content - cap it instead.
    @media (width >= 48em) {
        [data-category-heading] {
            display: none;
        }

        @media (width >= 75em) {
            max-width: 90rem;
        }
    }
}
