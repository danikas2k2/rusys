.App {
    --default-block-start: 44px;

    display: flex;
    flex-direction: column;
    align-items: center;
    position: absolute;
    inset: var(--safe-block-start, var(--default-block-start)) var(--safe-inline-start, 0) var(--safe-inline-end, 0) var(--safe-inline-end, 0);

    &.center {
        --default-block-start: 0;

        display: flex;
        align-items: center;
        justify-content: center;
        position: absolute;
    }
}
