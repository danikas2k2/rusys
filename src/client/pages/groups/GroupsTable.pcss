.ui-Table-table[data-table="groups"] {
    width: 100%;

    @media (width >= 36em) {
        max-width: 36rem;
    }

    .ui-Table-th:nth-child(-n + 2),
    .ui-Table-td:nth-child(-n + 2) {
        width: 2.5rem;
        padding-inline: 0;
        text-align: center;
    }

    [data-drag-handle] {
        justify-content: center;
    }

    .ui-Table-td:nth-child(2) .ui-Avatar-root {
        margin-inline: auto;
    }

    .ui-Table-tr[data-editable] {
        cursor: pointer;

        &:hover,
        &:focus-visible {
            background-color: var(--mantine-color-neutral-1);
        }

        &:focus-visible {
            outline: 2px solid var(--mantine-primary-color-filled);
            outline-offset: -2px;
        }
    }

    [data-drag-handle][data-disabled="true"] {
        cursor: not-allowed;
        opacity: 0.35;
    }
}
