.ReviewBox-filter {
    flex: 1;
    min-width: 0;
    margin-inline-start: 42px;

    @media (width >= 48em) {
        // The modal body has no inline padding: compensate for the header's md padding so the
        // filter begins exactly after the responsive category rail and its 4px layout gap.
        width: 100%;
        max-width: 28rem;
        margin-inline-start: calc(var(--category-rail-width) + 4px - var(--mantine-spacing-md));
    }
}
