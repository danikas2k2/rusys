.ui-Card-root[data-summary-tile] {
    [data-tile-icon] {
        width: 1.25rem;
    }

    [data-tile-heading] {
        grid-column: 1 / -1;
    }

    [data-tile-amounts] {
        max-width: 100%;
        text-align: end;

        > .ui-Stack-root,
        [data-type] {
            width: 100%;
            min-width: 0;
            max-width: 100%;
        }

        [data-amounts-rows],
        [data-amounts-row] {
            width: 100%;
            min-width: 0;
            max-width: 100%;
        }

        [data-amounts-row] {
            justify-content: flex-end;
        }

        [data-value],
        [data-sources] {
            min-width: 0;
            max-width: 100%;
            flex-wrap: wrap;
            justify-content: flex-end;
            overflow-wrap: anywhere;
        }

        [data-sources] {
            row-gap: 0;
        }
    }
}
