:global(.mantine-ActionIcon-root).AddAction {
    position: fixed;
    inset-block-end: 0.5rem;
    inset-inline-end: 0.5rem;
    z-index: 100;
    box-shadow: var(--shadow-medium);
    transition: opacity 0.1s ease-out;
    opacity: 1;
    pointer-events: auto;

    &[data-hidden="true"] {
        opacity: 0;
        pointer-events: none;
        transition-delay: 0s;
    }
}
