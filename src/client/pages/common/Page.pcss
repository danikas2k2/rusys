.ui-AppShell-root {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    padding-block: var(--safe-block-start) var(--safe-block-end);
    padding-inline: 0;
    height: 100dvh;
    min-height: 100vh;

    // iOS PWA / Safari can report a smaller dynamic viewport height.
    // Prefer the "large viewport" when supported to avoid layout ending above the bottom edge.
    @supports (height: 100lvh) {
        height: 100lvh;
    }

    .ui-AppShell-header,
    .ui-AppShell-footer {
        border: none;
        position: static;
        flex-shrink: 0;
    }

    .ui-AppShell-header,
    .ui-AppShell-footer,
    .ui-AppShell-main {
        padding-inline: var(--safe-inline-start) var(--safe-inline-end);
    }

    .ui-AppShell-main {
        flex: 1;
        min-height: 0;

        > div {
            position: sticky;
        }

        &[data-no-scroll] {
            [data-scrollarea-viewport] {
                overflow: hidden !important;
                touch-action: none !important;
                overscroll-behavior: none !important;
            }
        }
    }

    .ui-AppShell-footer {
        font-size: var(--mantine-font-size-sm);
        box-shadow: 0 -12px 16px var(--mantine-color-body);
        padding-inline: calc(var(--mantine-spacing-xs) + var(--safe-inline-start))
            calc(var(--mantine-spacing-xs) + var(--safe-inline-end));
        padding-block: calc(var(--mantine-spacing-xs) / 2) calc(var(--mantine-spacing-xs) / 2 + var(--safe-block-end));
        margin-block-end: calc(-1 * var(--safe-block-end));
    }
}
