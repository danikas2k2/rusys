// [data-value] normally lays out just a number + unit (justify-content: space-between, sized
// for two children) - here it also carries the parenthesized source breakdown, so it needs its
// own start-aligned, gapped layout instead.
[data-annotated="true"] {
    width: 100%;
    min-width: 0;
    max-width: 100%;

    [data-amounts-row] {
        width: 100%;
        min-width: 0;
        max-width: 100%;
        justify-content: flex-end;
    }

    [data-value="true"] {
        min-width: 0;
        max-width: 100%;
        flex: 0 1 auto;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 0;
        overflow-wrap: anywhere;
    }

    [data-sources] {
        display: flex;
        min-width: 0;
        max-width: 100%;
        flex: 1 1 auto;
        flex-wrap: wrap;
        justify-content: flex-end;
        margin-inline-start: 0.2rem;

        // Each raw source is an independent flex item, so a long parenthesized breakdown can
        // wrap between values instead of behaving as one unbreakable inline block.
        [data-value="true"] {
            flex: 0 1 auto;
        }
    }
}
