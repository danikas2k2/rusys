// Only the grid ("plytelės") view needs this - the table view already has its own sticky
// thead (see .ui-Table-thead in index.pcss) covering the same view-toggle/checkbox row, and
// stacking two independently sticky headers here would make them overlap at scroll time.
[data-products-header][data-view='grid'] {
    position: sticky;
    top: 0;
    z-index: 2;
    background-color: var(--mantine-color-body);
}
