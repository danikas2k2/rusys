.ui-Card-root[data-tile='product'] {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    cursor: pointer;
    transition: border-color 150ms ease-in-out;
    background-color: var(--mantine-color-body);

    &[data-hidden="true"] {
        display: none;
    }

    &[data-summary="true"] {
        background-color: var(--mantine-color-neutral-0);
    }

    &[data-expanded-parent="true"] {
        overflow: visible;
        background-color: var(--mantine-color-neutral-0);
        border-color: var(--mantine-color-primary-filled);

        &::before {
            content: "";
            position: absolute;
            z-index: -1;
            inset-inline: -1px;
            bottom: calc(var(--mantine-spacing-xs) * -1.5);
            height: calc(var(--mantine-spacing-xs) * 2);
            border-inline: 1px solid var(--mantine-color-primary-filled);
        }

        &::after {
            content: "";
            position: absolute;
            inset-inline: 0;
            bottom: calc(var(--mantine-spacing-xs) * -1.5);
            height: calc(var(--mantine-spacing-xs) * 2);
            background-color: var(--mantine-color-neutral-0);
        }
    }

    &[data-removing="true"] {
        border: 2px solid var(--mantine-color-negative-filled);

        [data-tile-heading] {
            padding-inline-end: 1.5rem;
        }
    }

    [data-removing-icon] {
        position: absolute;
        z-index: 2;
        inset-block-start: 0.35rem;
        inset-inline-end: 0.35rem;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 1.35rem;
        height: 1.35rem;
        border-radius: 50%;
        color: var(--mantine-color-negative-text);
        background-color: var(--mantine-color-body);
        box-shadow: 0 0 4px var(--mantine-color-shadow);
    }

    &[data-empty="true"] {
        opacity: 0.55;
    }

    [data-content] {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        grid-template-rows: auto 1fr;
    }

    [data-tile-icon] {
        grid-column: 1;
        grid-row: 1;
        align-self: start;
    }

    [data-tile-heading] {
        grid-column: 2;
        grid-row: 1;
        align-self: start;
    }

    [data-tile-amounts] {
        grid-column: 2;
        grid-row: 2;
        align-self: end;
        width: 100%;
        min-width: 0;

        [data-amounts-rows] {
            width: 100%;
            min-width: 0;
        }

        [data-amounts-row] {
            justify-content: flex-end;
        }
    }

    [data-icon-bg] {
        position: absolute;
        inset-inline-start: 4px;
        inset-block-start: 4px;
        width: 76px;
        height: 76px;
        background-size: cover;
        background-position: center;
        filter: blur(3px) opacity(0.5);
        pointer-events: none;
    }

    .ui-Checkbox-input {
        &:checked,
        &[data-indeterminate] {
            background-color: var(--mantine-color-body);
        }
    }

    &[data-photo="true"] {
        [data-photo-bg] {
            position: absolute;
            inset: 0;
            background-size: cover;
            background-position: center;
            filter: blur(2px);
        }

        [data-scrim] {
            position: absolute;
            inset: 0;
            background: var(--mantine-color-crust);
            opacity: 0.375;
        }
    }

    @media (hover: hover) {
        &:hover {
            border-color: var(--mantine-color-primary-filled);
        }
    }
}
