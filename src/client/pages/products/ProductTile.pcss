.ui-Card-root[data-tile='product'] {
    position: relative;
    overflow: hidden;
    cursor: pointer;
    transition: border-color 150ms ease-in-out;

    // Mantine's Card (unlike Paper) fills itself via --mantine-color-dark-6 in dark mode, which
    // this app's theme maps to a text shade (subtext0), not a surface shade - overriding with
    // the same body variable every other surface in the app already uses avoids that mismatch.
    background-color: var(--mantine-color-body);

    &[data-hidden='true'] {
        display: none;
    }

    &[data-summary='true'] {
        background-color: var(--mantine-color-neutral-0);
    }

    // Matches the background of the children panel rendered right below it (see
    // [data-children-panel] in ProductsGrid.pcss, at its normal position/radius, no shift). The
    // ::after bridges the grid gap between this tile and that panel with the same background and
    // side borders, its height covering the gap plus this tile's own bottom padding so it fully
    // overlaps (and so hides) this tile's bottom border and rounded bottom corners. Needs
    // overflow visible so that bridge isn't clipped by the tile's own bounds - the one tradeoff is
    // a parent that's also in photo mode (rare: a product with children rarely has its own image)
    // loses the scrim's rounded-corner clipping while expanded.
    &[data-expanded-parent='true'] {
        overflow: visible;
        background-color: var(--mantine-color-neutral-0);
        border-color: var(--mantine-color-primary-filled);

        &::before {
            content: '';
            position: absolute;
            z-index: -1;
            inset-inline: -1px;
            bottom: calc(var(--mantine-spacing-xs) * -1.5);
            height: calc(var(--mantine-spacing-xs) * 2);
            border-inline: 1px solid var(--mantine-color-primary-filled);
        }

        &::after {
            content: '';
            position: absolute;
            inset-inline: 0;
            bottom: calc(var(--mantine-spacing-xs) * -1.5);
            height: calc(var(--mantine-spacing-xs) * 2);
            background-color: var(--mantine-color-neutral-0);
        }
    }

    // A zero quantity has nothing to act on beyond opening the dialog to add a first amount -
    // dimmed to read as disabled, same as the table's own greyed-out empty cells.
    &[data-empty='true'] {
        opacity: 0.55;
    }

    // Grid (not flex) so the title and the amounts row below it share exactly the same column -
    // the amounts wrap at the title's own width instead of spilling under the icon column, and
    // there's no icon-column width to duplicate in CSS to keep the two in sync.
    [data-content] {
        display: grid;
        grid-template-columns: auto 1fr;
        grid-template-rows: auto 1fr;
    }

    [data-tile-icon] {
        grid-column: 1;
        grid-row: 1;
        align-self: start;
    }

    [data-tile-title] {
        grid-column: 2;
        grid-row: 1;
        align-self: start;
    }

    // Full width, with each wrapped line right-aligned within it - a shrink-to-fit box (the
    // Group's own default) would only line its right edge up with the tile's when the widest
    // wrapped line happens to be the last one, leaving any shorter line hanging off to the left.
    [data-tile-amounts] {
        grid-column: 2;
        grid-row: 2;
        align-self: end;
        width: 100%;

        [data-amounts-rows] {
            width: 100%;
        }

        [data-amounts-row] {
            justify-content: flex-end;
        }
    }

    // Pulls the icon avatar's own footprint out of the flow so it overlaps rather than pushing
    // the checkbox column (and so the card) taller than it needs to be.
    .ui-Avatar-root {
        margin-block-end: -100%;
    }

    // The outline variant's checked/indeterminate state is otherwise a transparent box with just
    // a coloured checkmark - fine on the app's own chrome, but it lets a photo tile's background
    // bleed through behind it. Body-colour keeps the outline look (no filled box) while staying
    // legible against any background. Mantine's own rule for this targets a raw, unprefixed
    // CSS-module class (no `[data-variant]` attribute exists to hook into), so this instead wins
    // on specificity via the tile ancestor - the only checkbox rendered inside a tile is this one.
    .ui-Checkbox-input {
        &:checked,
        &[data-indeterminate] {
            background-color: var(--mantine-color-body);
        }
    }

    // A background photo isn't part of the app's own light/dark chrome, so it needs its own
    // fixed (not scheme-reactive) scrim + light text rather than the usual theme variables -
    // the photo's colors don't change with the theme toggle, so neither should its contrast fix.
    &[data-photo='true'] {
        background-size: cover;
        background-position: center;

        --mantine-color-text: #fff;
        --mantine-color-dimmed: rgb(255 255 255 / 75%);

        [data-scrim] {
            position: absolute;
            inset: 0;
            background: linear-gradient(to bottom, rgb(0 0 0 / 10%), rgb(0 0 0 / 65%));
        }

        [data-content] {
            position: relative;
            z-index: 1;
        }

        .ui-Text-root {
            text-shadow: 0 1px 3px rgb(0 0 0 / 85%);
        }
    }

    @media (hover: hover) {
        &:hover {
            border-color: var(--mantine-color-primary-filled);
        }
    }
}
