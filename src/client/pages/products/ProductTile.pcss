.ui-Card-root[data-tile='product'] {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    cursor: pointer;
    transition: border-color 150ms ease-in-out;

    // Mantine's Card (unlike Paper) fills itself via --mantine-color-dark-6 in dark mode, which
    // this app's theme maps to a text shade (subtext0), not a surface shade - overriding with
    // the same body variable every other surface in the app already uses avoids that mismatch.
    background-color: var(--mantine-color-body);

    &[data-hidden='true'] {
        display: none;
    }

    &[data-summary='true'] {
        background-color: var(--mantine-color-neutral-0);
    }

    // Matches the background of the children panel rendered right below it (see
    // [data-children-panel] in ProductsGrid.pcss, at its normal position/radius, no shift). The
    // ::after bridges the grid gap between this tile and that panel with the same background and
    // side borders, its height covering the gap plus this tile's own bottom padding so it fully
    // overlaps (and so hides) this tile's bottom border and rounded bottom corners. Needs
    // overflow visible so that bridge isn't clipped by the tile's own bounds - the one tradeoff is
    // a parent that's also in photo mode (rare: a product with children rarely has its own image)
    // loses the scrim's rounded-corner clipping while expanded.
    &[data-expanded-parent='true'] {
        overflow: visible;
        background-color: var(--mantine-color-neutral-0);
        border-color: var(--mantine-color-primary-filled);

        &::before {
            content: '';
            position: absolute;
            z-index: -1;
            inset-inline: -1px;
            bottom: calc(var(--mantine-spacing-xs) * -1.5);
            height: calc(var(--mantine-spacing-xs) * 2);
            border-inline: 1px solid var(--mantine-color-primary-filled);
        }

        &::after {
            content: '';
            position: absolute;
            inset-inline: 0;
            bottom: calc(var(--mantine-spacing-xs) * -1.5);
            height: calc(var(--mantine-spacing-xs) * 2);
            background-color: var(--mantine-color-neutral-0);
        }
    }

    // Border makes the state visible at a glance; the matching delete icon in the tile explains
    // what the color means and keeps the status understandable without relying on color alone.
    &[data-removing='true'] {
        border: 2px solid var(--mantine-color-negative-filled);

        [data-tile-title] {
            padding-inline-end: 1.5rem;
        }
    }

    [data-removing-icon] {
        position: absolute;
        z-index: 2;
        inset-block-start: 0.35rem;
        inset-inline-end: 0.35rem;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 1.35rem;
        height: 1.35rem;
        border-radius: 50%;
        color: var(--mantine-color-negative-text);
        background-color: var(--mantine-color-body);
        box-shadow: 0 0 4px var(--mantine-color-shadow);
    }

    // A zero quantity has nothing to act on beyond opening the dialog to add a first amount -
    // dimmed to read as disabled, same as the table's own greyed-out empty cells.
    &[data-empty='true'] {
        opacity: 0.55;
    }

    // Grid (not flex) so the title and the amounts row below it share exactly the same column -
    // the amounts wrap at the title's own width instead of spilling under the icon column, and
    // there's no icon-column width to duplicate in CSS to keep the two in sync. Positioned (not
    // just display: grid) so it paints above [data-scrim]/[data-icon-bg], which are both
    // position: absolute and would otherwise paint on top of static content regardless of DOM order.
    [data-content] {
        position: relative;
        z-index: 1;
        display: grid;
        // minmax(0, 1fr) lets the amounts column shrink to the tile width. A plain 1fr keeps
        // the column's intrinsic content width, so a long amounts block can slide past the card.
        grid-template-columns: auto minmax(0, 1fr);
        grid-template-rows: auto 1fr;
    }

    [data-tile-icon] {
        grid-column: 1;
        grid-row: 1;
        align-self: start;
    }

    [data-tile-title] {
        grid-column: 2;
        grid-row: 1;
        align-self: start;
    }

    // Full width, with each wrapped line right-aligned within it - a shrink-to-fit box (the
    // Group's own default) would only line its right edge up with the tile's when the widest
    // wrapped line happens to be the last one, leaving any shorter line hanging off to the left.
    [data-tile-amounts] {
        grid-column: 2;
        grid-row: 2;
        align-self: end;
        width: 100%;
        min-width: 0;

        [data-amounts-rows] {
            width: 100%;
            min-width: 0;
        }

        [data-amounts-row] {
            justify-content: flex-end;
        }
    }

    // The icon-sized image, shown as a corner watermark instead of inline next to the checkbox -
    // capped at 80x80 (not full tile width, unlike [data-photo]) so it reads as a small badge, not
    // a background. The card's own overflow: hidden clips it to the top-left corner's radius.
    // Blurred and dimmed so it stays a decorative backdrop, never competing with the checkbox/
    // title/amounts stacked on top of it (see the shared :has() block below for how those stay
    // legible over it, exactly the same way they do over a full [data-photo-bg]).
    [data-icon-bg] {
        position: absolute;
        inset-inline-start: 4px;
        inset-block-start: 4px;
        width: 76px;
        height: 76px;
        background-size: cover;
        background-position: center;
        filter: blur(3px) opacity(0.5);
        pointer-events: none;
    }

    // Text/checkbox shadow is one recipe, shared by icon and photo mode alike - only the glow
    // colour differs (--tile-glow, set per mode below), because icon mode leaves the theme's own
    // text colour in place (small corner image, most of the tile is still the normal background)
    // while photo mode forces white text (see --mantine-color-text below) against a full backdrop.
    --tile-glow: var(--mantine-color-white);
    --tile-color: var(--mantine-color-crust);

    &:has([data-icon-bg], [data-photo-bg]) {
        [data-tile-icon] {
            filter: drop-shadow(0 0 1px var(--mantine-color-crust))
                drop-shadow(0 0 2px var(--mantine-color-crust))
                drop-shadow(0 0 4px var(--mantine-color-crust));
        }

        [data-content] {
            --text-shadow: var(--mantine-color-neutral-text);

            text-shadow:
                1px 0 1px var(--text-shadow),
                0 1px 2px var(--mantine-color-crust),
                1px 0 4px var(--mantine-color-crust),
                0 1px 8px var(--mantine-color-crust),
                1px 0 12px var(--mantine-color-crust);
        }
    }

    // The outline variant's checked/indeterminate state is otherwise a transparent box with just
    // a coloured checkmark - fine on the app's own chrome, but it lets a photo tile's background
    // bleed through behind it. Body-colour keeps the outline look (no filled box) while staying
    // legible against any background. Mantine's own rule for this targets a raw, unprefixed
    // CSS-module class (no `[data-variant]` attribute exists to hook into), so this instead wins
    // on specificity via the tile ancestor - the only checkbox rendered inside a tile is this one.
    .ui-Checkbox-input {
        &:checked,
        &[data-indeterminate] {
            background-color: var(--mantine-color-body);
        }
    }

    // A background photo isn't part of the app's own light/dark chrome, so it needs its own
    // fixed (not scheme-reactive) scrim + light text rather than the usual theme variables -
    // the photo's colors don't change with the theme toggle, so neither should its contrast fix.
    // Text/checkbox shadow itself is the shared recipe above - this only points --tile-glow at a
    // dark colour instead of the (light-on-dark-mode-adapting) theme one, since text here is
    // forced white against a full backdrop rather than left at the theme's normal colour.
    &[data-photo='true'] {
        // --mantine-color-dimmed: rgb(255 255 255 / 75%);

        [data-photo-bg] {
            position: absolute;
            inset: 0;
            background-size: cover;
            background-position: center;
            filter: blur(1px);
        }

        [data-scrim] {
            position: absolute;
            inset: 0;
            background: linear-gradient(to right bottom, color-mix(in srgb, var(--mantine-color-base) 30%, transparent), color-mix(in srgb, var(--mantine-color-crust) 70%, transparent));
        }
    }

    @media (hover: hover) {
        &:hover {
            border-color: var(--mantine-color-primary-filled);
        }
    }
}
