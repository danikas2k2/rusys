.Table {
    /* Let SwipeableTableRow handle touch events for swipe */
}

:global(.mantine-Table-tbody) :global(.mantine-Table-tr) :global(.mantine-Table-td) {
    /* Allow swipe events to pass through to SwipeableTableRow */
    pointer-events: auto;
}

:global(.mantine-Table-tbody) :global(.mantine-Table-tr) :global(.mantine-Table-td) > * {
    /* Child elements (like Checkbox) should still be interactive */
    pointer-events: auto;
}

.HeadRow {
    font-weight: var(--font-weight-semi-bold);
    padding-inline: 0.25rem 0.5rem;
}
