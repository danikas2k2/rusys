/* The outer edge padding matches SimpleGrid's own inter-tile spacing (see GRID_SPACING in */

/* ProductsGrid.tsx) so the gap around the grid is the same size as the gap between tiles, */

/* instead of tiles running flush to the container edge while huge gaps separate them. */
[data-grid="products"] {
    padding-inline: var(--mantine-spacing-xs);

    /* Matches the table's own margin-block-end (see .ui-Table-table in index.css) - only the */

    /* top-level grid, not a nested one shown for an expanded group's children. */
    > .ui-SimpleGrid-root {
        margin-block-end: 1rem;
    }
}

/* Frames an expanded parent's children as one visual group, distinct from unrelated tiles in */

/* the surrounding rows. Sits at its normal grid position (full border-radius, no shift) - the */

/* expanded parent tile's own ::after (see [data-expanded-parent] in ProductTile.css) bridges the */

/* gap above it, so the two read as one continuous frame rather than two separate boxes. */

/* Recurses naturally for a grandchild's panel. */
[data-children-panel] {
    border: 1px solid var(--mantine-color-primary-filled);
    border-radius: var(--mantine-radius-md);
    background-color: var(--mantine-color-neutral-0);
    padding: var(--mantine-spacing-xs);
}

::view-transition-group(.grouped-product-update) {
    animation-duration: 180ms;
}

::view-transition-new(.product-tile-enter) {
    animation: 180ms ease-out both product-tile-fade-in;
}

::view-transition-old(.product-tile-exit) {
    animation: 120ms ease-in both product-tile-fade-out;
}

@keyframes product-tile-fade-in {
    from {
        opacity: 0;
    }
}

@keyframes product-tile-fade-out {
    to {
        opacity: 0;
    }
}

::view-transition-old(.missing-products-update) {
    animation: 100ms ease-in both page-fade-out;
}

::view-transition-new(.missing-products-update) {
    animation: 180ms ease-out both page-fade-in;
}
