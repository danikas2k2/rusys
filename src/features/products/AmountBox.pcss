.ui-Modal-root[data-dialog="product"] {
    .ui-Modal-content {
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .ui-Modal-header {
        align-items: flex-start;
        flex-shrink: 0;
    }

    /* The title holds only the product identity. Product actions live with the year controls, */

    /* safely away from the modal's own close button. */
    .ui-Modal-title {
        flex: 1;
        min-width: 0;
    }

    .ui-Modal-body {
        display: flex;
        flex: 1;
        min-height: 0;
        overflow: hidden;
    }

    .ui-Stack-root.amount-box-content {
        display: flex;
        flex: 1;
        min-height: 0;
        min-width: 0;
    }

    .ui-Tabs-root.amount-box-tabs {
        display: flex;
        flex: 1;
        flex-direction: column;
        min-height: 0;
        min-width: 0;
    }

    .amount-box-tabs > .ui-Tabs-list {
        z-index: 1;
        flex: 0 0 auto;
        background-color: var(--mantine-color-body);
    }

    .ui-Tabs-panel.amount-box-tab-panel {
        flex: 1;
        min-height: 0;
        min-width: 0;
        max-width: 100%;
        overflow-y: auto;
        overscroll-behavior: contain;
    }

    .ui-Tabs-panel.amount-box-quantities-panel {
        display: flex;
        overflow: hidden;
    }

    .ui-Stack-root.amount-variants-tab {
        flex: 1;
        min-height: 0;
    }

    .amount-variants-list {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
    }

    /* Accordion content is a nested flex item. Without a zero min-width, its */

    /* intrinsic width (inputs, buttons, or an image dropzone) can widen the */

    /* fullscreen dialog beyond a narrow mobile viewport. */
    .ui-Accordion-root,
    .ui-Accordion-panel {
        min-width: 0;
        max-width: 100%;
    }

    /* In a short list actions follow the content. Once the panel scrolls, they stay pinned to */

    /* its bottom edge so they remain usable without leaving the current variant. */
    .amount-box-actions {
        position: sticky;
        bottom: 0;
        z-index: 1;
        background-color: var(--mantine-color-body);
        padding-top: var(--mantine-spacing-sm);
    }

    .amount-box-footer {
        flex: 0 0 auto;
        background-color: var(--mantine-color-body);
        padding-top: var(--mantine-spacing-sm);

        .amount-box-actions {
            position: static;
        }
    }

    .ui-Accordion-item {
        transition: none;
    }

    @media (hover: hover) {
        .ui-Accordion-control:where(:not(:disabled, [data-disabled])):hover {
            background-color: transparent;
        }
    }

    @media (hover: none) {
        .ui-Accordion-control:where(:not(:disabled, [data-disabled])):active {
            background-color: transparent;
        }
    }

    .ui-Accordion-item[data-active] .ui-Accordion-control,
    .ui-Accordion-item[data-active] .ui-Accordion-panel {
        background-color: var(--mantine-color-soft);
    }

    .ui-Accordion-item:last-of-type[data-active] .ui-Accordion-control {
        border-end-start-radius: 0;
        border-end-end-radius: 0;
    }

    .ui-Accordion-item:last-of-type[data-active] .ui-Accordion-panel {
        border-end-start-radius: var(--mantine-radius-md);
        border-end-end-radius: var(--mantine-radius-md);
    }

    .ui-Accordion-item[data-suspicious="true"] {
        border-inline-start: 2px solid var(--mantine-color-moderate-filled);
        border-start-start-radius: 0;
        border-end-start-radius: 0;
        opacity: 0.85;
    }

    .ui-Accordion-item[data-suspicious="true"][data-active] {
        opacity: 1;
    }

    .ui-Accordion-item[data-home="true"] {
        border-inline-start: 2px solid var(--mantine-color-blue-filled);
        border-start-start-radius: 0;
        border-end-start-radius: 0;
        opacity: 0.85;
    }

    .ui-Accordion-item[data-home="true"][data-active] {
        opacity: 1;
    }
}

.ui-Select-option:has([data-separator="true"]) {
    border-top: 1px solid var(--mantine-color-default-border);
    border-radius: 0;
    margin-top: 0.25rem;
    padding-top: 0.5rem;
}
