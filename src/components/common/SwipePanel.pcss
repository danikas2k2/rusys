.ui-Group-root[data-swipe-controls="true"] {
    background-color: color-mix(in srgb, var(--mantine-color-body) 20%, transparent 80%);
    position: fixed;
    left: 100vw;
    padding-inline: 0 0.5rem;
    transition: transform 0.2s ease-out;
    display: flex;
    flex-wrap: nowrap;
    justify-content: flex-end;
    align-items: center;
    gap: 0.5rem;
    z-index: 300;
    border-radius: var(--mantine-radius-md) 0 0 var(--mantine-radius-md);
    pointer-events: none;

    /* Allow pointer events only on the panel itself */
    > * {
        pointer-events: auto;
        border-radius: var(--mantine-radius-md);
    }

    &[data-closing="true"] {
        pointer-events: none;
    }

    /* While the finger is actively dragging, track it 1:1 with no easing;
       the transition is only for the settle animation after release */
    &[data-dragging="true"] {
        transition: none;
    }

    .ui-Button-root {
        box-shadow: var(--mantine-shadow-lg);
    }
}
