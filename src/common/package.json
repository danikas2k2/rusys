{
    "name": "@rusys/common",
    "version": "0.0.0",
    "private": true,
    "exports": {
        ".": "./index.ts",
        "./*": "./*.ts"
    },
    "scripts": {
        "format": "prettier --config ../../prettier.config.js --ignore-path ../../.prettierignore --write .",
        "format:check": "prettier --config ../../prettier.config.js --ignore-path ../../.prettierignore --check .",
        "lint": "pnpm format:check && pnpm lint:ts && pnpm lint:es",
        "lint:ts": "tsc --noEmit -p tsconfig.json",
        "lint:es": "eslint --config ../../eslint.config.ts .",
        "test": "vitest run --root ../.. --config vitest.config.mts --project common",
        "test:coverage": "vitest run --root ../.. --config vitest.config.mts --project common --coverage",
        "test:watch": "vitest --root ../.. --config vitest.config.mts --project common",
        "check": "pnpm lint && pnpm test"
    }
}
