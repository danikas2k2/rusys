:root {
    --shadow-color: color(from light-dark(var(--ctp-latte-overlay2), var(--ctp-mocha-crust)) srgb r g b / 50%);
    --shadow-xsmall: 0px 2px 4px -1px var(--shadow-color), 0px 2px 4px -2px var(--shadow-color);
    --shadow-small: 0px 2px 4px -2px var(--shadow-color), 0px 4px 8px -2px var(--shadow-color);
    --shadow-medium: 0px 2px 8px -2px var(--shadow-color), 0px 6px 12px -2px var(--shadow-color);
    --shadow-large: 0px 2px 8px -2px var(--shadow-color), 0px 12px 16px -4px var(--shadow-color);
    --shadow-xlarge: 0px 2px 8px -2px var(--shadow-color), 0px 18px 24px -4px var(--shadow-color);
}
