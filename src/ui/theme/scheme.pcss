:root {
    &[data-color-scheme="light"] {
        --color-scheme: light;
    }

    &[data-color-scheme="dark"] {
        --color-scheme: dark;
    }

    &:not([data-color-scheme]) {
        @media (prefers-color-scheme: light) {
            --color-scheme: light;
        }

        @media (prefers-color-scheme: dark) {
            --color-scheme: dark;
        }
    }

    color-scheme: var(--color-scheme, auto);
}
