.Backdrop {
    position: fixed;
    inset: 0;
    backdrop-filter: blur(8px) contrast(80%) brightness(50%);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: var(--z-index-backdrop);
}

.Dialog {
    position: relative;
    width: fit-content;
    height: fit-content;
    min-width: 80vw;
    min-height: 20vh;
    max-width: 100vw;
    max-height: 80vh;
    overflow: auto;
    color: var(--color-text);
    background-color: var(--color-base);
    border-radius: var(--radius-medium);
    box-shadow: var(--shadow-xlarge);
    display: flex;
    flex-direction: column;

    /* noinspection CssOverwrittenProperties */
    margin: 0;

    /* noinspection CssOverwrittenProperties */
    margin: constant(safe-area-inset-top) constant(safe-area-inset-right) constant(safe-area-inset-bottom) constant(safe-area-inset-left);

    /* noinspection CssOverwrittenProperties */
    margin: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);

    &.fullscreen {
        position: absolute;
        max-width: 100vw;
        max-height: 100vh;
        width: 100vw;
        height: auto;
        margin: 0;

        /* noinspection CssOverwrittenProperties */
        inset: 44px 0 0;

        /* noinspection CssOverwrittenProperties */
        inset: constant(safe-area-inset-top) constant(safe-area-inset-right) constant(safe-area-inset-bottom) constant(safe-area-inset-left);

        /* noinspection CssOverwrittenProperties */
        inset: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
    }

    > * {
        padding: 1rem;
    }

    header {
        display: flex;
        align-items: flex-start;
        justify-content: center;
        font-size: var(--font-size-large);
        font-weight: var(--font-weight-semi-bold);
        position: sticky;
        top: 0;
        z-index: var(--z-index-sticky);
        background-color: var(--color-base);
    }

    main:empty {
        display: none;
    }

    footer {
        display: flex;
        align-items: flex-end;
        justify-content: center;
    }
}
