.Input {
    --input-color: var(--element-color);
    --input-bg: var(--element-bg);
    --input-border: var(--element-border);
    --input-active: var(--element-active, var(--element-color));
    --input-active-bg: var(--element-active-bg, var(--element-bg));
    --input-active-border: var(--element-active-border, var(--element-border));
    --input-hover: var(--element-hover, var(--element-color));
    --input-hover-bg: var(--element-hover-bg, var(--element-bg));
    --input-hover-border: var(--element-hover-border, var(--element-border));
    --input-disabled: var(--element-disabled, var(--element-color));
    --input-disabled-bg: var(--element-disabled-bg, var(--element-bg));
    --input-disabled-border: var(--element-disabled-border, var(--element-border));

    &.state-hover,
    &:hover,
    &:has(:hover) {
        --input-color: var(--input-hover);
        --input-bg: var(--input-hover-bg);
        --input-border: var(--input-hover-border);
    }

    // TODO add outline colors

    &.state-focus,
    &:focus,
    &:has(:focus) {
        --input-color: var(--input-hover);
        --input-bg: var(--input-hover-bg);
        --input-border: var(--input-hover-border);
    }

    &.state-active,
    &:active,
    &:has(:active) {
        --input-color: var(--input-active);
        --input-bg: var(--input-active-bg);
        --input-border: var(--input-active-border);
    }

    &.state-disabled,
    &:disabled,
    &:has(:disabled) {
        --input-color: var(--input-disabled);
        --input-bg: var(--input-disabled-bg);
        --input-border: var(--input-disabled-border);
    }

    &.size-small {
        --input-icon-size: var(--font-size-base);
        --input-font-size: var(--font-size-small);
        --input-min-size: 2rem;
        --input-padding-block: 0.125rem;
        --input-padding-inline: 0.75rem;
        --input-radius-size: var(--radius-small);
    }

    &.size-medium {
        --input-icon-size: var(--font-size-large);
        --input-font-size: var(--font-size-base);
        --input-min-size: 2.5rem;
        --input-padding-block: 0.25rem;
        --input-padding-inline: 1rem;
        --input-radius-size: var(--radius-medium);
    }

    &.size-large {
        --input-icon-size: var(--font-size-xxlarge);
        --input-font-size: var(--font-size-medium);
        --input-min-size: 3rem;
        --input-padding-block: 0.375rem;
        --input-padding-inline: 1.5rem;
        --input-radius-size: var(--radius-large);
    }

    &.spacing-none {
        --input-min-size: calc(var(--input-icon-size) + 2px);
        --input-spacing: 0;
        --input-radius-size: var(--radius-xsmall);
    }

    &.spacing-half {
        --input-spacing: 0.75;
    }

    &.spacing-small {
        --input-spacing: 1;
    }

    &.spacing-medium {
        --input-spacing: 1.25;
    }

    &.spacing-large {
        --input-spacing: 1.5;
    }

    position: relative;
    display: inline-flex;
    flex-flow: column nowrap;
    align-items: stretch;
    justify-content: center;

    .content {
        display: flex;
        flex-flow: row nowrap;
        align-items: stretch;
        justify-content: space-between;
    }

    color: var(--input-color);
    background-color: var(--input-bg);
    border: 1px solid var(--input-border);
    border-radius: var(--input-radius-size);

    &.full-width {
        width: 100%;
    }

    &.full-height {
        height: 100%;
    }

    &.with-label {
        margin-block-start: 2rem;
    }

    --input-placeholder-base-color: var(--input-color);

    &.placeholder-color-rosewater {
        --input-placeholder-base-color: var(--color-rosewater);
    }

    &.placeholder-color-flamingo {
        --input-placeholder-base-color: var(--color-flamingo);
    }

    &.placeholder-color-pink {
        --input-placeholder-base-color: var(--color-pink);
    }

    &.placeholder-color-mauve {
        --input-placeholder-base-color: var(--color-mauve);
    }

    &.placeholder-color-red {
        --input-placeholder-base-color: var(--color-red);
    }

    &.placeholder-color-maroon {
        --input-placeholder-base-color: var(--color-maroon);
    }

    &.placeholder-color-peach {
        --input-placeholder-base-color: var(--color-peach);
    }

    &.placeholder-color-yellow {
        --input-placeholder-base-color: var(--color-yellow);
    }

    &.placeholder-color-green {
        --input-placeholder-base-color: var(--color-green);
    }

    &.placeholder-color-teal {
        --input-placeholder-base-color: var(--color-teal);
    }

    &.placeholder-color-sky {
        --input-placeholder-base-color: var(--color-sky);
    }

    &.placeholder-color-sapphire {
        --input-placeholder-base-color: var(--color-sapphire);
    }

    &.placeholder-color-blue {
        --input-placeholder-base-color: var(--color-blue);
    }

    &.placeholder-color-lavender {
        --input-placeholder-base-color: var(--color-lavender);
    }

    --input-placeholder-color: color(from var(--input-placeholder-base-color) srgb r g b / 50%);
    --input-label-color: color(from var(--input-color) srgb r g b / 50%);

    label {
        font-size: 90%;
        position: absolute;
        inset: -1.5rem auto auto 0.125rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        color: var(--input-label-color);
        z-index: 1;
    }

    --min-width: calc(var(--input-min-size) * var(--input-spacing, 1));
    --min-height: calc(var(--input-min-size) * var(--input-spacing, 1));
    --padding-block: 0;
    --padding-inline: calc(var(--input-padding-inline) * var(--input-spacing, 1));

    input {
        font-family: var(--font-family-body), sans-serif;
        font-weight: var(--font-weight-light);
        font-size: var(--input-font-size);
        min-width: var(--min-width);
        min-height: var(--min-height);
        padding-block: var(--padding-block);
        padding-inline: var(--padding-inline);
        line-height: 1;
        text-decoration: none;
        color: inherit;
        background-color: transparent;
        border: none;
        outline: none;
        width: 100%;
        text-overflow: ellipsis;

        &::placeholder {
            color: var(--input-placeholder-color);
        }
    }

    + .error {
        font-size: 90%;
        color: var(--color-red);
        padding: 0.25rem 1rem 0.25rem 0.5rem;
        margin-block-start: -0.125rem;
    }

    .start-decorator,
    .end-decorator {
        display: flex;
        align-items: center; // stretch
        flex-shrink: 0;
        flex-flow: row nowrap;

        &.type-text {
            padding-inline: calc(var(--input-padding-inline) * var(--input-spacing, 1));
        }
    }

    .start-decorator {
        justify-content: flex-start;
    }

    .end-decorator {
        justify-content: flex-end;
    }

    &:has(.start-decorator.type-text) input {
        padding-inline-start: 0;
    }

    &:has(.end-decorator.type-text) input {
        padding-inline-end: 0;
    }

    .clear {
        opacity: 0.25;
        width: 2.5rem;
        padding: 0 0.25rem;
        margin-inline-start: -2.5rem;
    }
}
