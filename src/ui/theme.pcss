@import url('https://fonts.googleapis.com/css2?family=Noto+Color+Emoji&family=Noto+Sans+Display:ital,wdth,wght@0,62.5..100,100..900;1,62.5..100,100..900&family=Noto+Sans+Mono:wdth,wght@62.5..100,100..900&family=Noto+Sans:ital,wdth,wght@0,62.5..100,100..900;1,62.5..100,100..900&display=swap');

// Common parts
@import "@ui/theme/colors.pcss";

:root {
    //
    // Font family variables
    //

    --mantine-font-family-fallback: -apple-system, 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', 'Helvetica', 'Arial', sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji';
    --mantine-font-family: "NotoSans Nerd Font", "Noto Sans", "Noto Color Emoji", var(--mantine-font-family-fallback);
    --mantine-font-family-headings: "Noto Sans Display", var(--mantine-font-family-fallback);
    --mantine-font-family-monospace-fallback: ui-monospace, 'SFMono-Regular', 'Menlo', 'Monaco', 'Consolas', 'Liberation Mono', 'Courier New', monospace;
    --mantine-font-family-monospace: "NotoSansM Nerd Font", "Noto Sans Mono", "Source Code Pro", var(--mantine-font-family-monospace-fallback);

    //
    // Color scheme variables
    //

    &[data-mantine-color-scheme="light"] {
        --mantine-color-scheme: light;
    }

    &[data-mantine-color-scheme="dark"] {
        --mantine-color-scheme: dark;
    }

    &:not([data-mantine-color-scheme]) {
        @media (prefers-color-scheme: light) {
            --mantine-color-scheme: light;
        }

        @media (prefers-color-scheme: dark) {
            --mantine-color-scheme: dark;
        }
    }

    color-scheme: var(--mantine-color-scheme, auto);

    //
    // Shadow variables
    //

    --mantine-shadow-xs: 0 calc(0.125rem * var(--mantine-scale)) calc(0.25rem * var(--mantine-scale)) calc(-0.0625rem * var(--mantine-scale)) var(--color-shadow), 0 calc(0.125rem * var(--mantine-scale)) calc(0.25rem * var(--mantine-scale)) calc(-0.125rem * var(--mantine-scale)) var(--color-shadow);
    --mantine-shadow-sm: 0 calc(0.125rem * var(--mantine-scale)) calc(0.25rem * var(--mantine-scale)) calc(-0.125rem * var(--mantine-scale)) var(--color-shadow), 0 calc(0.25rem * var(--mantine-scale)) calc(0.5rem * var(--mantine-scale)) calc(-0.125rem * var(--mantine-scale)) var(--color-shadow);
    --mantine-shadow-md: 0 calc(0.125rem * var(--mantine-scale)) calc(0.5rem * var(--mantine-scale)) calc(-0.125rem * var(--mantine-scale)) var(--color-shadow), 0 calc(0.375rem * var(--mantine-scale)) calc(0.75rem * var(--mantine-scale)) calc(-0.125rem * var(--mantine-scale)) var(--color-shadow);
    --mantine-shadow-lg: 0 calc(0.125rem * var(--mantine-scale)) calc(0.5rem * var(--mantine-scale)) calc(-0.125rem * var(--mantine-scale)) var(--color-shadow), 0 calc(0.750rem * var(--mantine-scale)) calc(1rem * var(--mantine-scale)) calc(-0.25rem * var(--mantine-scale)) var(--color-shadow);
    --mantine-shadow-xl: 0 calc(0.125rem * var(--mantine-scale)) calc(0.5rem * var(--mantine-scale)) calc(-0.125rem * var(--mantine-scale)) var(--color-shadow), 0 calc(1.125rem * var(--mantine-scale)) calc(1.5rem * var(--mantine-scale)) calc(-0.25rem * var(--mantine-scale)) var(--color-shadow);

    //
    // Font weights
    //

    --mantine-font-weight-xs: 300;
    --mantine-font-weight-sm: 400; // normal
    --mantine-font-weight-md: 500;
    --mantine-font-weight-lg: 600;
    --mantine-font-weight-xl: 700; // bold

    //
    // Focus variables
    // TODO: not sure if still needed
    //

    //--focus-thickness: 2px;
    //--focus-outline-offset: var(--focus-thickness, 2px);
    //--focus-color: var(--color-blue);
    //--focus-outline: var(--focus-thickness, 2px) solid var(--focus-color);
}
