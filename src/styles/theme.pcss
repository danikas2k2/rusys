    --mantine-color-primary-outline: var(--mantine-color-blue-outline);
    --mantine-color-primary-outline-hover: var(--mantine-color-blue-outline-hover);

    /* secondary */
    --mantine-color-secondary-0: var(--mantine-color-violet-0);
