    --mantine-color-moderate-outline: var(--mantine-color-yellow-outline);
    --mantine-color-moderate-outline-hover: var(--mantine-color-yellow-outline-hover);

    /* neutral */
    --mantine-color-neutral-0: var(--mantine-color-gray-0);
    --mantine-color-neutral-1: var(--mantine-color-gray-1);
    --mantine-color-neutral-2: var(--mantine-color-gray-2);
