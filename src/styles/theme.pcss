    --mantine-color-secondary-light-hover: var(--mantine-color-violet-light-hover);
    --mantine-color-secondary-light-color: var(--mantine-color-violet-light-color);
    --mantine-color-secondary-outline: var(--mantine-color-violet-outline);
    --mantine-color-secondary-outline-hover: var(--mantine-color-violet-outline-hover);

    /* positive */
    --mantine-color-positive-0: var(--mantine-color-green-0);
    --mantine-color-positive-1: var(--mantine-color-green-1);
    --mantine-color-positive-2: var(--mantine-color-green-2);
    --mantine-color-positive-3: var(--mantine-color-green-3);
    --mantine-color-positive-4: var(--mantine-color-green-4);
    --mantine-color-positive-5: var(--mantine-color-green-5);
    --mantine-color-positive-6: var(--mantine-color-green-6);
    --mantine-color-positive-7: var(--mantine-color-green-7);
    --mantine-color-positive-8: var(--mantine-color-green-8);
    --mantine-color-positive-9: var(--mantine-color-green-9);
    --mantine-color-positive-text: var(--mantine-color-green-text);
    --mantine-color-positive-filled: var(--mantine-color-green-filled);
    --mantine-color-positive-filled-hover: var(--mantine-color-green-filled-hover);
    --mantine-color-positive-light: var(--mantine-color-green-light);
    --mantine-color-positive-light-hover: var(--mantine-color-green-light-hover);
    --mantine-color-positive-light-color: var(--mantine-color-green-light-color);
    --mantine-color-positive-outline: var(--mantine-color-green-outline);
    --mantine-color-positive-outline-hover: var(--mantine-color-green-outline-hover);

    /* negative */
    --mantine-color-negative-0: var(--mantine-color-red-0);
    --mantine-color-negative-1: var(--mantine-color-red-1);
    --mantine-color-negative-2: var(--mantine-color-red-2);
