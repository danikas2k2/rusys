{
    "extends": "@tsconfig/node18",
    "include": [
        "webpack/**/*"
    ],
    "exclude": [],
    "compilerOptions": {
        "baseUrl": ".",
        "lib": [],
        "esModuleInterop": true,
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "noFallthroughCasesInSwitch": true,
        "resolveJsonModule": true,
        "downlevelIteration": true,
        "preserveSymlinks": true,
        "types": ["node"]
    }
}
