{
    "verbose": true,
    "moduleFileExtensions": ["js", "jsx", "ts", "tsx"],
    "moduleNameMapper": {
        "\\.p?css$": "<rootDir>/jest/__mocks__/styleMock.js",
        "^@assets/(.*)$": "<rootDir>/src/assets/$1",
        "^@tests/(.*)$": "<rootDir>/src/tests/$1",
        "^@ui/(.*)$": "<rootDir>/src/ui/$1",
        "^~/(.*)$": "<rootDir>/src/$1"
    },
    "modulePathIgnorePatterns": ["<rootDir>/src/.*?\\.d\\.ts$", "<rootDir>/src/.*?/types\\.ts$"],
    "setupFilesAfterEnv": [
        "@testing-library/jest-dom",
        "jest-extended/all",
        "jest-chain",
        "jest-to-match-shape-of",
        "jest-expect-message",
        "<rootDir>/jest/setup.ts",
        "<rootDir>/jest/expect.ts"
    ],
    "testEnvironment": "jsdom",
    "transform": {
        "\\.[jt]sx?$": [
            "esbuild-jest",
            {
                "sourcemap": true
            }
        ],
        "\\.svg": "jest-transformer-svg"
    },
    "collectCoverage": false,
    "collectCoverageFrom": [
        "src/**/*.{ts,tsx}",
        "!src/**/*.d.ts",
        "!src/tutorial/**",
        "!src/tests/**",
        "!src/server/index.ts",
        "!src/server/dev.ts",
        "!src/server/api/debug.ts"
    ],
    "coverageReporters": ["text", "json", "lcov", "html"],
    "coverageThreshold": {
        "global": {
            "branches": 85,
            "functions": 85,
            "lines": 85,
            "statements": 85
        }
    }
}
