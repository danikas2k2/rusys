{
    "verbose": true,
    "moduleFileExtensions": ["js", "jsx", "ts", "tsx"],
    "moduleNameMapper": {
        "^@icons/(.*)$": "<rootDir>/src/icons/$1",
        "^@ui/(.*)$": "<rootDir>/src/ui/$1",
        "^~/(.*)$": "<rootDir>/src/$1"
    },
    "setupFilesAfterEnv": [
        "@testing-library/jest-dom",
        "jest-extended/all",
        "jest-chain",
        "jest-to-match-shape-of",
        "jest-expect-message"
    ],
    "testEnvironment": "jsdom",
    "transform": {
        "\\.[jt]sx?$": "esbuild-jest"
    },
    "collectCoverage": false,
    "collectCoverageFrom": ["src/**/*.{ts,tsx}", "!src/**/*.d.ts", "!src/data/**/*.ts"]
}
